<nav class="hover-gradient-nav">
  <ul>

    <li class="hn-item">
      <div class="hn-card">
        <a href="<%= root_path %>" class="hn-front">Home</a>
      </div>
    </li>

    <li class="hn-item">
      <div class="hn-card">
        <a href="<%= games_path %>" class="hn-front">Games</a>
      </div>
    </li>

    <li class="hn-item">
      <div class="hn-card">
        <a href="<%= events_path %>" class="hn-front">Events</a>
      </div>
    </li>

    <% if user_signed_in? %>
      <li class="hn-item hn-item--dashboard" data-controller="hub-menu">
        <div class="hn-card<%= ' hn-card--dashboard' if loadout_section_active? %>">
          <button type="button"
                  class="hn-front hn-dashboard-summary<%= ' hn-dashboard-summary--active' if loadout_section_active? %>"
                  data-hub-menu-target="button"
                  data-action="click->hub-menu#toggle"
                  aria-haspopup="true"
                  aria-expanded="false"
                  style="display:inline-flex;align-items:center;justify-content:center;min-height:2.7rem;padding:0.55rem 2.25rem 0.55rem 1rem;border:1px solid transparent;border-radius:0.95rem;background:transparent;color:var(--gb-muted);appearance:none;-webkit-appearance:none;box-shadow:none;font:inherit;line-height:1.2;cursor:pointer;">
              <span class="hn-dashboard-summary__label">Gaming Hub</span>
          </button>
          <div class="hn-dropdown-menu"
               role="menu"
               aria-label="Gaming Hub"
               data-hub-menu-target="menu"
               hidden
               style="position:absolute;top:calc(100% + 0.65rem);right:0;width:14rem;max-width:calc(100vw - 1rem);padding:0.5rem;background:rgba(10,10,18,0.98);border:1px solid rgba(255,255,255,0.08);border-radius:1rem;box-shadow:0 24px 40px rgba(0,0,0,0.46);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);overflow:hidden;z-index:2000;">
              <div class="hn-dropdown-menu__item">
                <a href="<%= my_profile_path %>" class="<%= hub_nav_link_class(my_profile_path) %>" style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;width:100%;padding:0.7rem 0.85rem;border-radius:0.8rem;text-decoration:none;">
                  <span class="hn-dropdown-menu__link-main" style="display:inline-flex;align-items:center;gap:0.65rem;min-width:0;flex:1 1 auto;white-space:nowrap;">
                    <i class="fa fa-user" style="width:16px;flex:0 0 16px;text-align:center;"></i>
                    <span>My Profile</span>
                  </span>
                </a>
              </div>
              <div class="hn-dropdown-menu__item">
                <a href="<%= my_games_path %>" class="<%= hub_nav_link_class(my_games_path) %>" style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;width:100%;padding:0.7rem 0.85rem;border-radius:0.8rem;text-decoration:none;">
                  <span class="hn-dropdown-menu__link-main" style="display:inline-flex;align-items:center;gap:0.65rem;min-width:0;flex:1 1 auto;white-space:nowrap;">
                    <i class="fa fa-gamepad" style="width:16px;flex:0 0 16px;text-align:center;"></i>
                    <span>My Games</span>
                  </span>
                  <span class="hn-dropdown-menu__count-badge" style="display:inline-flex;align-items:center;justify-content:center;min-width:1.8rem;padding:0.18rem 0.48rem;border-radius:999px;background:color-mix(in srgb, var(--gb-accent) 16%, transparent);color:var(--gb-text);font-size:0.72rem;font-weight:700;line-height:1;flex-shrink:0;"><%= @followed_games&.count || current_user.favourite_games.count %></span>
                </a>
              </div>
              <div class="hn-dropdown-menu__item">
                <a href="<%= my_patches_path %>" class="<%= hub_nav_link_class(my_patches_path) %>" style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;width:100%;padding:0.7rem 0.85rem;border-radius:0.8rem;text-decoration:none;">
                  <span class="hn-dropdown-menu__link-main" style="display:inline-flex;align-items:center;gap:0.65rem;min-width:0;flex:1 1 auto;white-space:nowrap;">
                    <i class="fa fa-file-text" style="width:16px;flex:0 0 16px;text-align:center;"></i>
                    <span>My Patches</span>
                  </span>
                  <span class="hn-dropdown-menu__count-badge" style="display:inline-flex;align-items:center;justify-content:center;min-width:1.8rem;padding:0.18rem 0.48rem;border-radius:999px;background:color-mix(in srgb, var(--gb-accent) 16%, transparent);color:var(--gb-text);font-size:0.72rem;font-weight:700;line-height:1;flex-shrink:0;"><%= @recent_patches&.count || 0 %></span>
                </a>
              </div>
              <div class="hn-dropdown-menu__item">
                <a href="<%= my_events_path %>" class="<%= hub_nav_link_class(my_events_path) %>" style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;width:100%;padding:0.7rem 0.85rem;border-radius:0.8rem;text-decoration:none;">
                  <span class="hn-dropdown-menu__link-main" style="display:inline-flex;align-items:center;gap:0.65rem;min-width:0;flex:1 1 auto;white-space:nowrap;">
                    <i class="fa fa-calendar" style="width:16px;flex:0 0 16px;text-align:center;"></i>
                    <span>My Events</span>
                  </span>
                  <span class="hn-dropdown-menu__count-badge" style="display:inline-flex;align-items:center;justify-content:center;min-width:1.8rem;padding:0.18rem 0.48rem;border-radius:999px;background:color-mix(in srgb, var(--gb-accent) 16%, transparent);color:var(--gb-text);font-size:0.72rem;font-weight:700;line-height:1;flex-shrink:0;"><%= @reminders&.count || current_user.reminders.count %></span>
                </a>
              </div>
              <div class="hn-dropdown-menu__item">
                <%= link_to find_friends_path, class: hub_nav_link_class(find_friends_path), style: "display:flex;align-items:center;justify-content:space-between;gap:0.75rem;width:100%;padding:0.7rem 0.85rem;border-radius:0.8rem;text-decoration:none;" do %>
                  <span class="hn-dropdown-menu__link-main" style="display:inline-flex;align-items:center;gap:0.65rem;min-width:0;flex:1 1 auto;white-space:nowrap;">
                    <i class="fa fa-users" style="width:16px;flex:0 0 16px;text-align:center;"></i>
                    <span>Find friends</span>
                  </span>
                <% end %>
              </div>
              <% if current_user.admin? %>
                <div class="hn-dropdown-menu__item">
                  <%= link_to admin_dashboard_path, class: hub_nav_link_class(admin_dashboard_path), style: "display:flex;align-items:center;justify-content:space-between;gap:0.75rem;width:100%;padding:0.7rem 0.85rem;border-radius:0.8rem;text-decoration:none;" do %>
                    <span class="hn-dropdown-menu__link-main" style="display:inline-flex;align-items:center;gap:0.65rem;min-width:0;flex:1 1 auto;white-space:nowrap;">
                      <i class="fa fa-shield" style="width:16px;flex:0 0 16px;text-align:center;"></i>
                      <span>Admin Panel</span>
                    </span>
                  <% end %>
                </div>
              <% end %>
          </div>
        </div>
      </li>
    <% else %>
      <li class="hn-item">
        <div class="hn-card">
          <a href="<%= new_user_session_path %>" class="hn-front">Login</a>
        </div>
      </li>
    <% end %>

  </ul>
</nav>
