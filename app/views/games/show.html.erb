<div class="game-show">
  <% all_patches_path = game_patches_path(@game) %>

  <div class="game-show__header">
    <% if @game.cover_image.present? %>
      <div class="game-show__banner-bg" style="background-image: url('<%= @game.cover_image %>')"></div>
    <% end %>
    <div class="container game-show__header-inner">
      <% if @game.cover_image.present? %>
        <div class="game-show__cover">
          <%= image_tag @game.cover_image, alt: @game.name, loading: "lazy" %>
        </div>
      <% end %>
      <div class="game-show__meta">
        <%
          safe_back = params[:return_to].presence if params[:return_to].to_s.start_with?('/') && !params[:return_to].to_s.start_with?('//')
          back_label = case safe_back
                       when my_profile_path then "← My Profile"
                       when ->(p) { p&.match?(%r{\A/users/\d+}) } then "← Profile"
                       else "← All games"
                       end
          back_url = safe_back || games_path
        %>
        <%= link_to back_label, back_url, class: "d-block mb-2", style: "font-size:0.82rem; color: rgba(255,255,255,0.45); text-decoration:none;" %>
        <h1><%= @game.name %></h1>
        <div class="game-show__meta-grid">
          <div class="game-show__stat-row">
            <span class="game-show__stat-pill">
              <i class="fa fa-file-text-o"></i>
              <%= pluralize(@game.patches.count, "patch") %>
            </span>
            <span class="game-show__stat-pill">
              <i class="fa fa-calendar"></i>
              <%= pluralize(@events.count, "upcoming event") %>
            </span>
            <% @game.genre_tags.each do |genre| %>
              <span class="game-show__genre-pill"><%= genre %></span>
            <% end %>
            <% if @game.free_to_play? %>
              <span class="game-show__genre-pill game-show__genre-pill--success">Free to play</span>
            <% end %>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap mt-2">
          <% if @favourite %>
            <%= button_to favourite_path(@favourite), method: :delete, class: "game-card__follow-btn game-card__follow-btn--active", aria: { label: "Unfavourite #{@game.name}" }, title: "Unfavourite #{@game.name}", form: { data: { controller: "unfollow-animation", action: "submit->unfollow-animation#submit" } } do %>
              <i class="fa fa-star" aria-hidden="true"></i>
            <% end %>
          <% else %>
            <%= button_to favourites_path, params: { game_id: @game.id }, class: "game-card__follow-btn game-card__follow-btn--inactive", aria: { label: "Favourite #{@game.name}" }, title: "Favourite #{@game.name}", data: { controller: "follow-sound", action: "click->follow-sound#play" } do %>
              <i class="fa fa-star-o" aria-hidden="true"></i>
            <% end %>
          <% end %>
          <% if current_user&.admin? && @scrape_source_config.present? %>
            <% if @scrape_source_config.fetch(:manual_trigger_enabled, true) %>
              <%= button_to "Run Patch Scrape", admin_patch_scrapes_path, params: { source: @scrape_source_config[:source] }, class: "btn btn-sm", style: "background: rgba(52,199,89,0.16); color: #7ee787; border: 1px solid rgba(126,231,135,0.45); border-radius: 2rem; padding: 0.3rem 1rem; font-weight:600; font-size:0.82rem;" %>
            <% else %>
              <button class="btn btn-sm" disabled style="background: rgba(79,156,249,0.14); color: #8dc2ff; border: 1px solid rgba(141,194,255,0.4); border-radius: 2rem; padding: 0.3rem 1rem; font-weight:600; font-size:0.82rem; opacity: 1; cursor: default;">AI</button>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="game-show__section">
          <div class="game-show__section-headline">
            <div>
              <h2 class="game-show__section-title">Patch Feed</h2>
            </div>
          </div>

          <div class="game-show__list-offset" style="margin-bottom: -15px;">
            <div class="game-show__patch-controls">
              <div class="game-show__filter-group">
                <%= link_to "All time", game_path(@game), class: "filter-btn #{@patch_date_filter == 'all' ? 'active' : ''}" %>
                <% Patch::DATE_FILTERS.except("all").each do |value, label| %>
                  <%= link_to label, game_path(@game, date_filter: value), class: "filter-btn #{@patch_date_filter == value ? 'active' : ''}" %>
                <% end %>
              </div>
              <% unless @patch_date_filter == "all" %>
                <%= link_to "Reset", game_path(@game), class: "game-show__reset-link" %>
              <% end %>
            </div>
          </div>

          <div class="text-end mb-3">
            <%= link_to "View all patches", all_patches_path, class: "game-show__section-link" %>
          </div>

          <% if @patches.any? %>
            <div class="row row-cols-1 g-3">
              <% @patches.each do |patch| %>
                <div class="col">
                  <%= link_to patch_path(patch, return_to: request.fullpath), class: "text-decoration-none" do %>
                    <div class="card h-100">
                      <div class="card-body">
                        <div class="patches-index__meta">
                          <% if patch.freshly_published? %>
                            <span class="patch-fresh-badge">New</span>
                          <% end %>
                        </div>
                        <h5 class="card-title"><%= patch.title %></h5>
                        <p class="patches-index__date"><%= patch.display_published_at.to_date.to_fs(:long) %></p>
                        <p class="card-text text-muted small"><%= patch.content.truncate(100) %></p>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="game-show__empty">No patches found for that date range.</p>
          <% end %>
        </div>
      </div>

      <div class="col-lg-5" data-controller="event-modal">
        <div class="game-show__section">
          <div class="game-show__section-headline">
            <div>
              <h2 class="game-show__section-title">Upcoming Events</h2>
            </div>
          </div>
          <% if @events.any? %>
            <% @events.each do |event| %>
              <%= link_to event_path(event), class: "event-list-card", data: { action: "click->event-modal#open" } do %>
                <div class="event-list-card__date">
                  <div class="day"><%= event.start_date&.strftime("%-d") %></div>
                  <div class="month"><%= event.start_date&.strftime("%b") %></div>
                </div>
                <span class="event-list-card__title"><%= event.title %></span>
                <span class="event-list-card__arrow"><i class="fa fa-chevron-right"></i></span>
              <% end %>
            <% end %>
          <% else %>
            <p class="game-show__empty">No upcoming events.</p>
          <% end %>
        </div>

        <div class="modal fade" id="event-modal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content gb-modal">
              <div class="modal-body p-0" data-event-modal-target="body"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
