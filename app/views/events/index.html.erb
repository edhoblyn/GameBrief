<% content_for :title, "Events" %>
<div class="events-index">
  <div class="container">

    <div class="events-index__controls">
      <div class="events-index__filters-row">
        <div class="events-index__filters" aria-label="Filter events by time">
        <% EventsController::TIME_FILTERS.each do |value, label| %>
            <%= link_to label, events_path(time_filter: (value == "all" ? nil : value), game_ids: (@selected_game_ids.presence if @selected_game_ids.any?)), class: "filter-btn #{@time_filter == value ? 'active' : ''}" %>
        <% end %>
        </div>

        <details class="events-index__game-filter">
          <summary class="events-index__game-filter-trigger <%= 'events-index__game-filter-trigger--active' if @selected_game_ids.any? %>">
            <span>
              <i class="fa fa-filter"></i>
              Filter by game
            </span>
            <% if @selected_game_ids.any? %>
              <strong><%= pluralize(@selected_game_ids.size, "game") %></strong>
            <% end %>
          </summary>

          <div class="events-index__game-filter-menu">
            <div class="events-index__game-filter-header">
              <p class="events-index__game-filter-title">Choose games</p>
              <%= link_to "Clear", events_path(time_filter: (@time_filter == "all" ? nil : @time_filter)), class: "events-index__game-filter-clear" %>
            </div>

            <%= form_with url: events_path, method: :get, local: true, class: "events-index__game-filter-form" do %>
              <% if @time_filter != "all" %>
                <%= hidden_field_tag :time_filter, @time_filter %>
              <% end %>

              <div class="events-index__game-filter-options">
                <% @game_filter_options.each do |game| %>
                  <label class="events-index__game-filter-option">
                    <%= check_box_tag "game_ids[]", game.id, @selected_game_ids.include?(game.id), class: "events-index__game-filter-checkbox" %>
                    <span><%= game.name %></span>
                  </label>
                <% end %>
              </div>

              <div class="events-index__game-filter-actions">
                <%= submit_tag "Apply", class: "events-index__game-filter-apply" %>
              </div>
            <% end %>
          </div>
        </details>
      </div>

      <div class="events-index__results-meta">
        <span><%= pluralize(@events.size, "event") %> in this view</span>
        <% if @time_filter != "all" || @selected_game_ids.any? %>
          <%= link_to "Reset filter", events_path, class: "events-index__reset" %>
        <% end %>
      </div>
    </div>

    <% if @events.any? %>
      <div class="events-index__timeline">
        <% @event_groups.each do |group_name, events| %>
          <section class="events-index__group">
            <div class="events-index__group-header">
              <h2 class="events-index__group-title"><%= group_name %></h2>
              <span class="events-index__group-count"><%= pluralize(events.size, "event") %></span>
            </div>

            <div class="events-index__group-list">
              <% events.each do |event| %>
                <article class="game-card event-glow-card">
                  <%= link_to event_path(event), class: "game-card__link", aria: { label: "View #{event.title}" } do %>
                    <span class="visually-hidden">View <%= event.title %></span>
                  <% end %>
                  <div class="game-card__cover">
                    <% if event.game.cover_image.present? %>
                      <%= image_tag event.game.cover_image, alt: event.game.name, class: "game-card__img", loading: "lazy" %>
                    <% else %>
                      <div class="game-card__placeholder">
                        <i class="fa fa-gamepad"></i>
                      </div>
                    <% end %>
                    <div class="game-card__overlay"></div>
                    <% if @followed_game_ids.include?(event.game_id) %>
                      <span class="event-card__badge">Following</span>
                    <% end %>
                    <div class="event-card__date-overlay">
                      <% if event.start_date.present? %>
                        <span class="event-card__date-num"><%= event.start_date.strftime("%-d") %></span>
                        <span class="event-card__date-label"><%= event.start_date.strftime("%b %Y") %></span>
                      <% else %>
                        <span class="event-card__date-num">TBD</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="game-card__body">
                    <p class="event-card__game-label"><%= event.game.name %></p>
                    <h3 class="game-card__name"><%= event.title %></h3>
                    <span class="game-card__cta">View event</span>
                  </div>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="events-index__empty">
        <div class="events-index__empty-icon">
          <i class="fa fa-calendar"></i>
        </div>
        <h2 class="events-index__empty-title">No events match this time range</h2>
        <p class="events-index__empty-copy">
          Try a broader filter to see more upcoming events, or head to your games list to follow titles you want surfaced first.
        </p>
        <div class="events-index__empty-actions">
          <% if @time_filter != "all" %>
            <%= link_to "View all upcoming", events_path, class: "events-index__action" %>
          <% end %>
          <%= link_to "Browse games", games_path, class: "events-index__action events-index__action--primary" %>
        </div>
      </div>
    <% end %>

  </div>
</div>
