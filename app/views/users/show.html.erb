<% content_for :title, "#{@user.display_name}'s Profile" %>

<div class="pub-profile-page">

  <div class="pub-profile-page__back">
    <%= link_to :back, class: "my-patches-page__action" do %>
      <i class="fa fa-arrow-left"></i>
      Back
    <% end %>
  </div>

  <div class="pub-profile-card-mini pub-profile-card-mini--page" data-user-id="<%= @user.id %>">
    <%= render "profile_card" %>
  </div>

</div>

<script>
(function () {
  var card = document.querySelector('.pub-profile-card-mini');
  if (card) {
    var nav = card.querySelector('.pub-profile-tab-nav');
    if (nav) {
      var tabs = nav.querySelectorAll('.pub-profile-tab[data-tab]');
      var panelContainer = card.querySelector('.pub-profile-tab-panels');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.dataset.tab;
          tabs.forEach(function (t) {
            var active = t.dataset.tab === target;
            t.style.borderBottomColor = active ? 'var(--gb-accent)' : 'transparent';
          });
          panelContainer.querySelectorAll('[data-panel]').forEach(function (p) {
            p.style.display = p.dataset.panel === target ? '' : 'none';
          });
        });
      });
    }
  }
})();
</script>

<% if user_signed_in? && current_user != @user %>
<script>
(function () {
  var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  wireFriendButtons(document.querySelector('.pub-profile-card-mini'), csrfToken);

  function wireFriendButtons(scope, csrf) {
    if (!scope) return;

    scope.querySelectorAll('.card-friend-btn').forEach(function (btn) {
      btn.addEventListener('click', function () { handleFriendAction(btn, scope, csrf); });
    });
  }

  function handleFriendAction(btn, scope, csrf) {
    var action       = btn.dataset.action;
    var userId       = btn.dataset.userId;
    var friendshipId = btn.dataset.friendshipId;

    if (action === 'add') {
      fetch('/friendships', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ friend_id: userId })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        btn.dataset.action = 'cancel';
        btn.dataset.friendshipId = data.friendship_id;
        btn.classList.remove('social-profile-action--primary');
        btn.innerHTML = '<i class="fa fa-clock-o me-1"></i> Pending';
      });

    } else if (action === 'cancel') {
      fetch('/friendships/' + friendshipId, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
      }).then(function () {
        btn.dataset.action = 'add';
        btn.dataset.friendshipId = '';
        btn.classList.add('social-profile-action--primary');
        btn.innerHTML = '<i class="fa fa-plus me-1"></i> Add Friend';
      });

    } else if (action === 'accept') {
      fetch('/friendships/' + friendshipId, {
        method: 'PATCH',
        headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
        wrap.outerHTML =
          '<button class="social-profile-action card-friend-btn"' +
            ' data-action="unfriend"' +
            ' data-user-id="' + userId + '"' +
            ' data-friendship-id="' + data.friendship_id + '">' +
            '<i class="fa fa-check me-1"></i> Friends' +
          '</button>';
        wireFriendButtons(scope, csrf);
      });

    } else if (action === 'decline') {
      fetch('/friendships/' + friendshipId, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
      }).then(function () {
        var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
        wrap.outerHTML =
          '<button class="social-profile-action social-profile-action--primary card-friend-btn"' +
            ' data-action="add"' +
            ' data-user-id="' + userId + '">' +
            '<i class="fa fa-plus me-1"></i> Add Friend' +
          '</button>';
        wireFriendButtons(scope, csrf);
      });

    } else if (action === 'unfriend') {
      fetch('/friendships/' + friendshipId, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
      }).then(function () {
        btn.dataset.action = 'add';
        btn.dataset.friendshipId = '';
        btn.classList.add('social-profile-action--primary');
        btn.innerHTML = '<i class="fa fa-plus me-1"></i> Add Friend';
      });
    }
  }
})();
</script>
<% end %>
