<% if message.role == "user" %>
  <div class="chatbot__message chatbot__message--user">
    <div class="chatbot__bubble">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
<% else %>
  <div class="chatbot__message chatbot__message--assistant">
    <div class="chatbot__mascot-avatar chatbot__mascot-avatar--inline">
      <svg width="28" height="28" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle class="briffy-bg briffy-border" cx="21" cy="21" r="20" stroke-width="1.5"/>
        <polygon class="briffy-ear" points="12,11 7,2 17,8"/>
        <polygon class="briffy-ear" points="30,11 35,2 25,8"/>
        <circle cx="15" cy="20" r="6.5" fill="white"/>
        <circle cx="27" cy="20" r="6.5" fill="white"/>
        <circle class="briffy-iris" cx="15" cy="20" r="4.5"/>
        <circle class="briffy-iris" cx="27" cy="20" r="4.5"/>
        <circle cx="15.8" cy="19.2" r="2.2" fill="#0d0d14"/>
        <circle cx="27.8" cy="19.2" r="2.2" fill="#0d0d14"/>
        <circle cx="16.8" cy="18.2" r="1" fill="white" opacity="0.9"/>
        <circle cx="28.8" cy="18.2" r="1" fill="white" opacity="0.9"/>
        <polygon points="21,25 19,28.5 23,28.5" fill="#fbbf24"/>
        <path class="briffy-smile" d="M14,33 Q21,38 28,33" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="chatbot__bubble">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
<% end %>
