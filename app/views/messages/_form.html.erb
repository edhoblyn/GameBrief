<% user_message_count = chat.user_message_count %>
<% limit_reached = chat.user_message_limit_reached? %>

<%= form_with model: [patch, chat, message],
              local: true,
              class: "chatbot__form",
              data: {
                turbo: false,
                action: "submit->chat-stream#submit",
                chat_stream_target: "form"
              } do |f| %>
  <div class="chatbot__composer">
    <div class="chatbot__input-row">
      <%= f.text_field :content,
            placeholder: "Briffy, what happened to snipers?",
            class: "chatbot__input",
            required: true,
            autocomplete: "off",
            disabled: limit_reached,
            data: { chat_stream_target: "input" } %>

      <div class="chatbot__actions">
        <%= f.submit "Ask me",
            class: "chatbot__submit",
            disabled: limit_reached,
            data: { chat_stream_target: "submit" } %>
      </div>
    </div>

<p data-chat-stream-target="limitMessage" class="chatbot__limit-reached" <%= limit_reached ? "" : "hidden" %>>
      You have reached the <%= Message::MAX_USER_MESSAGES %>-question limit for this chat.
    </p>
  </div>
<% end %>
