<div class="admin-panel-page container">
  <div class="admin-panel-page__hero">
    <div>
      <p class="admin-panel-page__eyebrow">Admin</p>
      <h1 class="admin-panel-page__title">Admin Panel</h1>
      <p class="admin-panel-page__subtitle">Run manual patch scrapes, event imports, and keep core admin workflows in one place.</p>
    </div>
    <div class="admin-panel-page__hero-actions">
      <%= link_to games_path, class: "admin-panel-page__action" do %>
        <i class="fa fa-gamepad"></i>
        Back to Games
      <% end %>
      <%= link_to my_profile_path, class: "admin-panel-page__action admin-panel-page__action--primary" do %>
        <i class="fa fa-user"></i>
        Profile
      <% end %>
    </div>
  </div>

  <%# Game imports section %>
  <section class="admin-panel-page__card admin-panel-page__card--games">
    <div class="admin-panel-page__section-header">
      <div>
        <p class="admin-panel-page__kicker">Manual Imports</p>
        <h2>Game imports</h2>
      </div>
      <div class="admin-panel-page__imports-toolbar">
        <%= button_to "Run all patches", run_all_admin_patch_scrapes_path, class: "admin-panel-page__button" %>
        <%= button_to "Run all events", run_all_admin_event_imports_path, class: "admin-panel-page__button admin-panel-page__button--blue" %>
      </div>
    </div>

    <div class="admin-panel-page__games-grid">
      <% @game_cards.each do |card| %>
        <div class="admin-game-card">
          <div class="admin-game-card__poster <%= 'admin-game-card__poster--no-image' unless card[:cover_image].present? %>"
               <% if card[:cover_image].present? %>style="background-image: url('<%= card[:cover_image] %>')"<% end %>>
            <div class="admin-game-card__overlay">
              <div class="admin-game-card__top">
                <div class="admin-game-card__status-dots">
                  <% if card[:patch] %><span class="admin-game-card__dot admin-game-card__dot--<%= card[:patch_status] || :idle %>" title="Patch: <%= card[:patch_status] || 'not run' %>"></span><% end %>
                  <% if card[:event] %><span class="admin-game-card__dot admin-game-card__dot--<%= card[:event_status] || :idle %>" title="Events: <%= card[:event_status] || 'not run' %>"></span><% end %>
                </div>
              </div>
              <div class="admin-game-card__bottom">
                <p class="admin-game-card__name"><%= card[:label] %></p>
                <div class="admin-game-card__actions">
                  <% if card[:patch] %>
                    <% if card[:patch][:manual_trigger_enabled] %>
                      <%= button_to "Patch", admin_patch_scrapes_path, params: { source: card[:patch][:source] }, class: "admin-game-card__btn admin-game-card__btn--patch" %>
                    <% else %>
                      <span class="admin-game-card__btn admin-game-card__btn--disabled">AI</span>
                    <% end %>
                  <% end %>
                  <% if card[:event] %>
                    <% if card[:event][:manual_trigger_enabled] %>
                      <%= button_to "Events", admin_event_imports_path, params: { source: card[:event][:source] }, class: "admin-game-card__btn admin-game-card__btn--event" %>
                    <% else %>
                      <span class="admin-game-card__btn admin-game-card__btn--disabled">Seeded</span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%# Utility row: admin access + demo reset %>
  <div class="admin-panel-page__utility-grid">
    <section class="admin-panel-page__card">
      <div class="admin-panel-page__section-header">
        <div>
          <p class="admin-panel-page__kicker">Active Admin</p>
          <h2>Admin access</h2>
        </div>
      </div>

      <div class="admin-panel-page__admin-form">
        <%= form_with url: admin_users_path, method: :post, local: true, class: "admin-panel-page__inline-form" do |form| %>
          <%= form.email_field :email, placeholder: "Add admin by email", class: "admin-panel-page__input", required: true %>
          <%= form.submit "Add admin", class: "admin-panel-page__button" %>
        <% end %>
      </div>

      <div class="admin-panel-page__admins">
        <% @admins.each do |admin| %>
          <article class="admin-panel-page__admin-row">
            <div>
              <%= link_to admin.display_name, user_path(admin), class: "admin-panel-page__admin-link" %>
              <p><%= admin.email %></p>
            </div>
            <%= button_to "Remove",
                          admin_user_path(admin),
                          method: :delete,
                          class: "admin-panel-page__button admin-panel-page__button--danger" %>
          </article>
        <% end %>
      </div>

      <div class="admin-panel-page__note">
        This page is intentionally the single entry point for admin-only tools so future actions do not get scattered across the product.
      </div>
    </section>

    <section class="admin-panel-page__card">
      <div class="admin-panel-page__section-header">
        <div>
          <p class="admin-panel-page__kicker">Demo Reset</p>
          <h2>AI chat history</h2>
        </div>
        <span class="admin-panel-page__pill"><%= pluralize(@chat_count, "chat") %></span>
      </div>

      <p class="admin-panel-page__copy">
        Remove all stored AI conversations before demos so every chat starts fresh.
      </p>

      <div class="admin-panel-page__note">
        <strong><%= @message_count %></strong> messages across <strong><%= @chat_count %></strong> chats. This action cannot be undone.
      </div>

      <div class="admin-panel-page__toolbar">
        <%= button_to "Clear AI chat history",
                      admin_chat_history_path,
                      method: :delete,
                      class: "admin-panel-page__button admin-panel-page__button--danger admin-panel-page__button--wide",
                      form: {
                        data: {
                          turbo_confirm: "Clear all AI chat history? This will permanently delete every stored chat and message."
                        }
                      } %>
      </div>
    </section>
  </div>

  <%# Collapsible patch scrape log %>
  <details class="admin-panel-page__card admin-panel-page__card--log admin-panel-page__details">
    <summary class="admin-panel-page__details-summary">
      <div>
        <p class="admin-panel-page__kicker">Scrape Log</p>
        <h2>Latest patch run output</h2>
      </div>
      <% if @scrape_log_status == "running" %>
        <span class="admin-panel-page__pill admin-panel-page__pill--running">Running…</span>
      <% elsif @scrape_logs.any? %>
        <% errors = @scrape_logs.count { |e| !e["success"] } %>
        <span class="admin-panel-page__pill <%= errors > 0 ? "admin-panel-page__pill--error" : "admin-panel-page__pill--ok" %>">
          <%= @scrape_logs.count %> sources · <%= errors %> errors
        </span>
      <% else %>
        <span class="admin-panel-page__pill">No runs yet</span>
      <% end %>
    </summary>

    <% if @scrape_log_status == "running" %>
      <p class="admin-panel-page__copy">A scrape run is currently in progress. Refresh shortly to see the latest output.</p>
    <% end %>

    <% if @scrape_logs.any? %>
      <div class="admin-panel-page__logs">
        <% @scrape_logs.each do |entry| %>
          <article class="admin-panel-page__log-entry <%= "admin-panel-page__log-entry--error" unless entry["success"] %>">
            <div class="admin-panel-page__log-topline">
              <strong><%= entry["label"] %></strong>
              <span><%= Time.zone.parse(entry["timestamp"]).strftime("%d %b %Y %H:%M") %></span>
            </div>
            <p>
              <%= entry["success"] ? "Success" : "Failed" %>:
              <%= entry["imported"] %> imported,
              <%= entry["skipped"] %> skipped
            </p>
            <% if entry["error_message"].present? %>
              <pre class="admin-panel-page__log-error"><%= entry["error_message"] %></pre>
            <% end %>
          </article>
        <% end %>
      </div>
    <% elsif @scrape_log_status == "running" %>
      <p class="admin-panel-page__empty-copy">All enabled scrapes are running in the background. Refresh in a moment for results.</p>
    <% else %>
      <p class="admin-panel-page__empty-copy">No scrape logs yet. Run a source or use Run all patches to populate this panel.</p>
    <% end %>
  </details>

  <%# Collapsible event import log %>
  <details class="admin-panel-page__card admin-panel-page__card--log admin-panel-page__details">
    <summary class="admin-panel-page__details-summary">
      <div>
        <p class="admin-panel-page__kicker">Event Import Log</p>
        <h2>Latest event run output</h2>
      </div>
      <% if @event_log_status == "running" %>
        <span class="admin-panel-page__pill admin-panel-page__pill--running">Running…</span>
      <% elsif @event_logs.any? %>
        <% errors = @event_logs.count { |e| !e["success"] } %>
        <span class="admin-panel-page__pill <%= errors > 0 ? "admin-panel-page__pill--error" : "admin-panel-page__pill--ok" %>">
          <%= @event_logs.count %> sources · <%= errors %> errors
        </span>
      <% else %>
        <span class="admin-panel-page__pill">No runs yet</span>
      <% end %>
    </summary>

    <% if @event_log_status == "running" %>
      <p class="admin-panel-page__copy">An event import run is currently in progress. Refresh shortly to see the latest output.</p>
    <% end %>

    <% if @event_logs.any? %>
      <div class="admin-panel-page__logs">
        <% @event_logs.each do |entry| %>
          <article class="admin-panel-page__log-entry <%= "admin-panel-page__log-entry--error" unless entry["success"] %>">
            <div class="admin-panel-page__log-topline">
              <strong><%= entry["label"] %></strong>
              <span><%= Time.zone.parse(entry["timestamp"]).strftime("%d %b %Y %H:%M") %></span>
            </div>
            <p>
              <%= entry["success"] ? "Success" : "Failed" %>:
              <%= entry["imported"] %> imported,
              <%= entry["skipped"] %> skipped
            </p>
            <% if entry["error_message"].present? %>
              <pre class="admin-panel-page__log-error"><%= entry["error_message"] %></pre>
            <% end %>
          </article>
        <% end %>
      </div>
    <% elsif @event_log_status == "running" %>
      <p class="admin-panel-page__empty-copy">All event imports are running in the background. Refresh in a moment for results.</p>
    <% else %>
      <p class="admin-panel-page__empty-copy">No event import logs yet. Run a source or use Run all events to populate this panel.</p>
    <% end %>
  </details>
</div>
