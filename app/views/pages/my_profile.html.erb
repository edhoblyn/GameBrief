<% content_for :title, "My Profile" %>

<%

  profile_name   = current_user.display_name
  profile_handle = current_user.profile_handle
  profile_highlights = [
    { label: "Favourited games", value: @followed_games.count, icon: "fa-gamepad" },
    { label: "Patch drops", value: @recent_patches.count, icon: "fa-file-text" },
    { label: "Event reminders", value: @reminders.count, icon: "fa-calendar" }
  ]
  next_reminder = @reminders.first
  latest_patch = @recent_patches.first
%>

<div class="container my-profile-layout" data-controller="notification-toggles">

  <!-- Sidebar -->
  <aside class="profile-sidebar profile-sidebar--hidden" id="profile-sidebar">
    <div class="profile-sidebar__user">
      <div class="profile-sidebar__avatar">
        <% if current_user.avatar_image.attached? %>
          <%= image_tag current_user.avatar_image, class: "profile-sidebar__avatar-img" %>
        <% elsif current_user.avatar_url.present? %>
          <%= image_tag current_user.avatar_url, class: "profile-sidebar__avatar-img" %>
        <% else %>
          <div class="profile-sidebar__avatar-placeholder">
            <%= current_user.email.first.upcase %>
          </div>
        <% end %>
      </div>
      <div class="profile-sidebar__name"><%= profile_name %></div>
      <div class="profile-sidebar__handle">@<%= profile_handle %></div>
    </div>

    <nav class="profile-sidebar__nav">
      <a href="<%= root_path %>" class="profile-sidebar__nav-link">
        <i class="fa fa-home"></i> Home
      </a>
      <a href="#" class="profile-sidebar__nav-link profile-sidebar__nav-link--active">
        <i class="fa fa-user"></i> My Profile
      </a>
      <a href="<%= my_games_path %>" class="profile-sidebar__nav-link">
        <i class="fa fa-gamepad"></i> My Games
        <span class="profile-sidebar__count-badge ms-auto"><%= @followed_games.count %></span>
      </a>
      <a href="<%= my_patches_path %>" class="profile-sidebar__nav-link">
        <i class="fa fa-file-text"></i> My Patches
        <span class="profile-sidebar__count-badge ms-auto"><%= @recent_patches.count %></span>
      </a>
      <a href="<%= my_events_path %>" class="profile-sidebar__nav-link">
        <i class="fa fa-calendar"></i> My Events
        <span class="profile-sidebar__count-badge ms-auto"><%= @reminders.count %></span>
      </a>
      <%= link_to find_friends_path, class: "profile-sidebar__nav-link" do %>
        <i class="fa fa-users"></i> Find friends
      <% end %>
    </nav>

    <section class="profile-sidebar__section">
      <div class="profile-sidebar__section-header">
        <h3 class="profile-sidebar__section-title">Notifications</h3>
        <span class="profile-sidebar__section-badge">Live</span>
      </div>

      <div class="profile-sidebar__control-list">
        <button type="button"
                class="profile-sidebar__control profile-sidebar__control--active"
                data-action="click->notification-toggles#toggle"
                data-notification-toggles-target="toggle"
                data-notification-key="patch-alerts"
                data-notification-default-state="on"
                aria-pressed="true">
          <span class="profile-sidebar__control-copy">
            <span class="profile-sidebar__control-label">Patch alerts</span>
            <span class="profile-sidebar__control-meta">Major game updates and fresh patch drops</span>
          </span>
          <span class="profile-sidebar__control-state profile-sidebar__control-state--active"
                data-notification-toggles-target="state">On</span>
        </button>

        <button type="button"
                class="profile-sidebar__control profile-sidebar__control--active"
                data-action="click->notification-toggles#toggle"
                data-notification-toggles-target="toggle"
                data-notification-key="event-reminders"
                data-notification-default-state="on"
                aria-pressed="true">
          <span class="profile-sidebar__control-copy">
            <span class="profile-sidebar__control-label">Event reminders</span>
            <span class="profile-sidebar__control-meta">Upcoming events from your favourited games</span>
          </span>
          <span class="profile-sidebar__control-state profile-sidebar__control-state--active"
                data-notification-toggles-target="state">On</span>
        </button>

        <button type="button"
                class="profile-sidebar__control"
                data-action="click->notification-toggles#toggle"
                data-notification-toggles-target="toggle"
                data-notification-key="recommendation-updates"
                data-notification-default-state="off"
                aria-pressed="false">
          <span class="profile-sidebar__control-copy">
            <span class="profile-sidebar__control-label">Recommendation updates</span>
            <span class="profile-sidebar__control-meta">Suggestions based on your activity</span>
          </span>
          <span class="profile-sidebar__control-state"
                data-notification-toggles-target="state">Off</span>
        </button>
      </div>
    </section>

    <div class="profile-sidebar__footer">
      <%= link_to "Sign out", destroy_user_session_path, data: { "turbo-method": :delete }, class: "profile-sidebar__signout" %>
    </div>
  </aside>

  <!-- Social main -->
  <main class="social-main" data-controller="social-feed" style="display: flex; flex-direction: column;">

    <!-- Profile header -->
    <div class="social-profile-header">
      <% banner_style = current_user.cover_image.attached? ? "background-image: linear-gradient(rgba(7, 10, 22, 0.18), rgba(7, 10, 22, 0.52)), url('#{url_for(current_user.cover_image)}');" : nil %>
      <div class="social-profile-banner"<%= banner_style.present? ? " style=\"#{banner_style}\"".html_safe : "" %>></div>
      <div class="social-profile-info">
        <div class="social-profile-top-row">
          <div class="social-profile-avatar-wrap">
            <% if current_user.avatar_image.attached? %>
              <%= image_tag current_user.avatar_image, class: "social-profile-avatar social-profile-avatar--img" %>
            <% elsif current_user.avatar_url.present? %>
              <%= image_tag current_user.avatar_url, class: "social-profile-avatar social-profile-avatar--img" %>
            <% else %>
              <div class="social-profile-avatar">
                <%= current_user.email.first.upcase %>
              </div>
            <% end %>
          </div>
          <%= link_to "Edit Profile", edit_user_registration_path, class: "btn-edit-profile" %>
        </div>

        <div class="social-profile-identity">
          <h2 class="social-profile-name"><%= profile_name %></h2>
          <span class="social-profile-handle">@<%= profile_handle %></span>
        </div>
        <p class="social-profile-bio">Casual gamer. Patch notes enthusiast. Always one update behind.</p>
        <div class="social-profile-highlights">
          <% profile_highlights.each do |item| %>
            <div class="profile-highlight-card">
              <div class="profile-highlight-card__icon">
                <i class="fa <%= item[:icon] %>"></i>
              </div>
              <div class="profile-highlight-card__body">
                <span class="profile-highlight-card__value"><%= item[:value] %></span>
                <span class="profile-highlight-card__label"><%= item[:label] %></span>
              </div>
            </div>
          <% end %>
        </div>
        <div class="social-profile-actions">
          <%= link_to my_games_path, class: "social-profile-action social-profile-action--primary" do %>
            <i class="fa fa-gamepad"></i>
            Manage Games
          <% end %>
          <%= link_to my_events_path, class: "social-profile-action" do %>
            <i class="fa fa-calendar"></i>
            My Events
          <% end %>
        </div>
        <div class="social-profile-stats">
          <a href="<%= find_friends_path(friends_only: 1) %>" class="social-stat">
            <span class="social-stat__count"><%= current_user.friends.count %></span>
            <span class="social-stat__label"><%= pluralize(current_user.friends.count, "Friend").split.first == "1" ? "Friend" : "Friends" %></span>
          </a>
          <a href="#" class="social-stat">
            <span class="social-stat__count"><%= current_user.posts.count%></span>
            <span class="social-stat__label"><%= pluralize(current_user.posts.count, "Post").split.first == "1" ? "Post" : "Posts" %></span>
          </a>
        </div>
      </div>
    </div>


    <div class="p-3" style="display: flex; flex-direction: column; gap: 10px; max-width: 75%;">
        <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted); margin-bottom: 4px;">Feed</p>
        <% if @feed_posts.any? %>
          <% @feed_posts.each do |post| %>
            <div style="padding: 14px 16px; border-radius: 18px 18px 18px 4px; background: linear-gradient(135deg, rgba(124,92,252,0.12), rgba(79,156,249,0.07)); border: 1px solid rgba(124,92,252,0.25); transition: border-color 0.15s, transform 0.15s;">
              <div class="d-flex align-items-center gap-2 mb-2">
                <div style="width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent), var(--gb-accent-strong)); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: #fff; flex-shrink: 0;">
                  <%= post.user.display_name.first.upcase %>
                </div>
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--gb-text);"><%= post.user.display_name %></span>
                <span style="color: var(--gb-muted); font-size: 0.75rem; margin-left: auto;"><%= time_ago_in_words(post.created_at) %> ago</span>
                <% if post.user == current_user %>
                  <%= button_to post_path(post), method: :delete, class: "btn btn-link btn-sm p-0", style: "color: rgba(255,255,255,0.25); font-size: 0.75rem; line-height: 1;", form: { data: { turbo_confirm: "Delete this post?" } } do %>
                    <i class="fa fa-trash"></i>
                  <% end %>
                <% end %>
              </div>
              <p style="margin: 0; font-size: 0.88rem; color: var(--gb-text); line-height: 1.55;"><%= post.body %></p>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted" style="font-size: 0.85rem;">No posts yet.</p>
        <% end %>
    </div>

    <div class="px-3 pb-3 d-flex justify-content-between align-items-center mt-auto">
      <div>
        <button id="new-post-btn" onclick="document.getElementById('new-post-form').style.display='flex'; this.style.display='none';" class="btn btn-primary btn-sm" style="border-radius: 999px; font-size: 0.82rem; padding: 0.35rem 1.1rem;">
          <i class="fa fa-pencil me-1"></i> Post
        </button>

        <div id="new-post-form" style="display: none; padding: 14px 16px; border-radius: 16px; background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)); border: 1px solid rgba(255,255,255,0.1);">
          <%= form_with url: posts_path, scope: :post, class: "d-flex flex-column gap-2" do |f| %>
            <%= f.text_area :body, placeholder: "What's on your mind?", rows: 2, class: "form-control", style: "background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 10px; font-size: 0.95rem; resize: none; line-height: 1.5;" %>
            <div class="d-flex gap-2 justify-content-end">
              <button type="button" onclick="document.getElementById('new-post-form').style.display='none'; document.getElementById('new-post-btn').style.display='inline-flex';" class="btn btn-sm" style="border-radius: 999px; font-size: 0.78rem; color: var(--gb-muted);">Cancel</button>
              <%= f.submit "Post", class: "btn btn-primary btn-sm", style: "border-radius: 999px; font-size: 0.78rem; padding: 0.3rem 1rem;" %>
            </div>
          <% end %>
        </div>
      </div>

      <%= link_to find_friends_path, class: "btn btn-primary btn-sm", style: "border-radius: 999px; font-size: 0.82rem; padding: 0.35rem 1.1rem;" do %>
        <i class="fa fa-users me-1"></i> Find Friends
      <% end %>
    </div>

  </main>
</div>
