<% content_for :title, "My Profile" %>
<meta name="turbo-cache-control" content="no-cache">

<%

  profile_name   = current_user.display_name
  profile_handle = current_user.profile_handle
  profile_highlights = [
    { label: "Favourited games", value: @followed_games.count, icon: "fa-gamepad",   url: my_games_path, toggle_games: true },
    { label: "Patch drops",      value: @recent_patches.count, icon: "fa-file-text", url: my_patches_path },
    { label: "Event reminders",  value: @reminders.count,      icon: "fa-calendar",  url: my_events_path }
  ]
  next_reminder = @reminders.first
  latest_patch = @recent_patches.first
%>

<div class="container my-profile-layout" data-controller="notification-toggles">

  <!-- Sidebar -->
  <%= render "shared/profile_sidebar", active: :profile %>

  <!-- Social main -->
  <main class="social-main" data-controller="social-feed">

    <!-- Profile header -->
    <div class="social-profile-header">
      <% banner_style = current_user.cover_image.attached? ? "background-image: linear-gradient(rgba(7, 10, 22, 0.18), rgba(7, 10, 22, 0.52)), url('#{url_for(current_user.cover_image)}');" : nil %>
      <div class="social-profile-banner"<%= banner_style.present? ? " style=\"#{banner_style}\"".html_safe : "" %>>
        <%= form_with url: user_registration_path, method: :patch, multipart: true, class: "banner-upload-form" do |f| %>
          <%= f.hidden_field :email, value: current_user.email %>
          <%= f.file_field :cover_image, id: "banner-cover-input", accept: "image/*", style: "display:none", onchange: "this.form.submit()" %>
        <% end %>
        <label for="banner-cover-input" class="banner-edit-btn" title="Modifier la bannière">
          <i class="fa fa-pencil"></i>
        </label>
      </div>
      <div class="social-profile-info">
        <div class="social-profile-top-row">
          <div class="social-profile-avatar-wrap">
            <% if current_user.avatar_image.attached? %>
              <%= image_tag current_user.avatar_image, class: "social-profile-avatar social-profile-avatar--img" %>
            <% elsif current_user.avatar_url.present? %>
              <%= image_tag current_user.avatar_url, class: "social-profile-avatar social-profile-avatar--img" %>
            <% else %>
              <div class="social-profile-avatar">
                <%= current_user.email.first.upcase %>
              </div>
            <% end %>
            <%= form_with url: user_registration_path, method: :patch, multipart: true, class: "avatar-upload-form" do |f| %>
              <%= f.hidden_field :email, value: current_user.email %>
              <%= f.file_field :avatar_image, id: "avatar-image-input", accept: "image/*", style: "display:none", onchange: "this.form.submit()" %>
            <% end %>
            <label for="avatar-image-input" class="avatar-edit-btn" title="Modifier la photo de profil">
              <i class="fa fa-pencil"></i>
            </label>
          </div>
          <%= link_to "Edit Profile", edit_user_registration_path, class: "btn-edit-profile" %>
        </div>

        <div class="social-profile-identity">
          <h2 class="social-profile-name"><%= profile_name %></h2>
          <span class="social-profile-handle">@<%= profile_handle %></span>
        </div>
        <p class="social-profile-bio">Casual gamer. Patch notes enthusiast. Always one update behind.</p>
        <div class="social-profile-highlights">
          <% profile_highlights.each do |item| %>
            <% if item[:toggle_games] %>
              <button type="button" id="games-tab-btn" class="profile-highlight-card profile-highlight-card--link" data-games-tab-toggle>
                <div class="profile-highlight-card__icon">
                  <i class="fa <%= item[:icon] %>"></i>
                </div>
                <div class="profile-highlight-card__body">
                  <span class="profile-highlight-card__value"><%= item[:value] %></span>
                  <span class="profile-highlight-card__label"><%= item[:label] %></span>
                </div>
              </button>
            <% else %>
              <%= link_to item[:url], class: "profile-highlight-card profile-highlight-card--link" do %>
                <div class="profile-highlight-card__icon">
                  <i class="fa <%= item[:icon] %>"></i>
                </div>
                <div class="profile-highlight-card__body">
                  <span class="profile-highlight-card__value"><%= item[:value] %></span>
                  <span class="profile-highlight-card__label"><%= item[:label] %></span>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <div class="social-profile-stats">
          <button type="button" class="social-stat" data-bs-toggle="modal" data-bs-target="#friendsModal">
            <span class="social-stat__count"><%= current_user.friends.count %> <%= current_user.friends.count == 1 ? "Friend" : "Friends" %></span>
            <% if @pending_received_count > 0 %>
              <span class="pending-badge"><%= @pending_received_count %></span>
            <% end %>
          </button>
          <button type="button" class="social-stat" data-bs-toggle="modal" data-bs-target="#findFriendsModal">
            <span class="social-stat__count"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></span>
            <span class="social-stat__count">Find Friends</span>
          </button>
        </div>
      </div>
    </div>

    <div id="social-panel">
    <div class="for-you-layout">
      <div class="for-you-feed">

        <%# Top actions bar %>
        <div class="px-3 pt-3 pb-2 d-flex justify-content-between align-items-center">
          <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted); margin: 0;">FriendHub</p>
          <div class="d-flex gap-2 align-items-center">
<button id="new-post-btn" class="compose-btn" style="display: none;" onclick="document.getElementById('new-post-form').style.display='block'; this.style.display='none';">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Post
            </button>
          </div>
        </div>

        <%# New post form (visible by default) %>
        <div id="new-post-form" class="compose-form-wrapper">
          <%= form_with url: posts_path, scope: :post do |f| %>
            <div class="compose-form__avatar">
              <% if current_user.avatar_image.attached? %>
                <%= image_tag current_user.avatar_image, class: "compose-form__avatar-img" %>
              <% else %>
                <div class="compose-form__avatar-placeholder"><%= current_user.display_name.first.upcase %></div>
              <% end %>
            </div>
            <div class="compose-form__body">
              <%= f.text_area :body, placeholder: "What's on your mind?", rows: 2, class: "compose-form__textarea", autofocus: true %>
              <div class="compose-form__actions">
                <button type="button" class="compose-form__cancel" onclick="document.getElementById('new-post-form').style.display='none'; document.getElementById('new-post-btn').style.display='inline-flex';">Cancel</button>
                <%= f.submit "Post", class: "compose-form__submit" %>
              </div>
            </div>
          <% end %>
        </div>

        <%# Posts feed %>
        <div class="p-3" style="display: flex; flex-direction: column; gap: 10px;">
          <% if @feed_posts.any? %>
            <% @feed_posts.each do |post| %>
              <% liked = post.likes.exists?(user: current_user) %>
              <div style="border-radius: 18px; border: 1px solid rgba(124,92,252,0.25); overflow: hidden; background: rgba(255,255,255,0.02);">
                <%# Post header %>
                <div style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: linear-gradient(135deg, rgba(124,92,252,0.15), rgba(79,156,249,0.08)); border-bottom: 1px solid rgba(255,255,255,0.06);">
                  <div style="width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent), var(--gb-accent-strong)); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: #fff; flex-shrink: 0; overflow: hidden;">
                    <% if post.user.avatar_image.attached? %>
                      <%= image_tag post.user.avatar_image, style: "width: 100%; height: 100%; object-fit: cover;" %>
                    <% else %>
                      <%= post.user.display_name.first.upcase %>
                    <% end %>
                  </div>
                  <%= link_to post.user.display_name, user_path(post.user), style: "font-size: 0.85rem; font-weight: 700; color: var(--gb-text); text-decoration: none;" %>
                  <span style="color: var(--gb-muted); font-size: 0.72rem; margin-left: auto;"><%= time_ago_in_words(post.created_at) %> ago</span>
                  <% if post.user == current_user %>
                    <%= button_to post_path(post), method: :delete, class: "btn btn-link btn-sm p-0 ms-1", style: "color: rgba(255,255,255,0.2); font-size: 0.72rem; line-height: 1;", form: { data: { turbo_confirm: "Delete this post?" } } do %>
                      <i class="fa fa-trash"></i>
                    <% end %>
                  <% end %>
                </div>
                <%# Post body %>
                <div style="padding: 12px 14px 8px;">
                  <p style="margin: 0 0 10px; font-size: 0.88rem; color: var(--gb-text); line-height: 1.6;"><%= post.body %></p>
                  <%# Rocket reaction %>
                  <div style="display: flex; align-items: center; gap: 4px;">
                    <% if liked %>
                      <%= button_to post_like_path(post, post.likes.find_by(user: current_user)), method: :delete, class: "like-btn liked", title: "Un-rocket" do %>
                        <i class="fa fa-rocket"></i>
                      <% end %>
                    <% else %>
                      <%= button_to post_likes_path(post), method: :post, class: "like-btn", title: "Rocket!" do %>
                        <i class="fa fa-rocket"></i>
                      <% end %>
                    <% end %>
                    <span class="like-count"><%= post.likes.count %></span>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted" style="font-size: 0.85rem;">No posts yet.</p>
          <% end %>
        </div>

        <div class="px-3 pb-3"></div>
      </div>

      <aside class="for-you-sidebar">
        <section id="my-events" class="profile-rail-card">
          <div class="profile-rail-card__header">
            <h3 class="profile-rail-card__title">Upcoming Event</h3>
            <%= link_to "All events", my_events_path, class: "profile-rail-card__link" %>
          </div>
          <% if next_reminder.present? %>
            <%= link_to event_path(next_reminder.event), class: "profile-rail-feature" do %>
              <span class="profile-rail-feature__eyebrow"><%= next_reminder.event.game.name %></span>
              <h4 class="profile-rail-feature__title"><%= next_reminder.event.title %></h4>
              <p class="profile-rail-feature__meta">
                <i class="fa fa-calendar"></i>
                <%= next_reminder.event.start_date.strftime("%-d %b %Y") %>
              </p>
            <% end %>
          <% else %>
            <p class="profile-rail-card__empty">No reminders set yet. <%= link_to "Browse events", events_path %>.</p>
          <% end %>
        </section>

        <section id="my-patches" class="profile-rail-card">
          <div class="profile-rail-card__header">
            <h3 class="profile-rail-card__title">Latest Patch</h3>
            <%= link_to "View patches", my_patches_path, class: "profile-rail-card__link" %>
          </div>
          <% if latest_patch.present? %>
            <%= link_to patch_path(latest_patch), class: "profile-rail-feature" do %>
              <span class="profile-rail-feature__eyebrow"><%= latest_patch.game.name %></span>
              <h4 class="profile-rail-feature__title"><%= latest_patch.title %></h4>
              <p class="profile-rail-feature__meta">
                <i class="fa fa-clock-o"></i>
                <%= latest_patch.display_published_at.to_date.to_fs(:long) %>
              </p>
            <% end %>
          <% else %>
            <p class="profile-rail-card__empty">No recent patches for your favourited games.</p>
          <% end %>
        </section>
      </aside>
    </div>
    </div><%# /social-panel %>

    <%# Games panel — shown when Favourited Games button is clicked %>
    <div id="games-panel" style="display: none;">
      <div class="px-3 pt-3 pb-2 d-flex align-items-center gap-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
        <button type="button" id="games-panel-back" style="display: inline-flex; align-items: center; gap: 6px; background: none; border: none; color: var(--gb-muted); font-size: 0.82rem; cursor: pointer; padding: 0; font-family: inherit; transition: color 0.15s;" onmouseover="this.style.color='var(--gb-text)'" onmouseout="this.style.color='var(--gb-muted)'">
          <i class="fa fa-arrow-left"></i> Back to Feed
        </button>
      </div>
      <div class="my-games-page">
        <div class="my-games-page__header">
          <div class="my-games-page__heading">
            <h1 class="my-games-page__title">My Games</h1>
            <p class="my-games-page__subtitle">Favourited games, all in one place.</p>
          </div>
        </div>

        <% if @games.any? %>
          <div class="my-games-page__grid">
            <% @games.each do |game| %>
              <div class="game-card-wrapper">
                <%= link_to game_path(game, return_to: my_profile_path), class: "game-card event-glow-card" do %>
                  <div class="game-card__cover">
                    <% if game.cover_image.present? %>
                      <%= image_tag game.cover_image, alt: game.name, class: "game-card__img", loading: "lazy" %>
                    <% else %>
                      <div class="game-card__placeholder">
                        <i class="fa fa-gamepad"></i>
                      </div>
                    <% end %>
                    <div class="game-card__overlay"></div>
                  </div>
                  <div class="game-card__body">
                    <h3 class="game-card__name"><%= game.name %></h3>
                    <span class="game-card__cta">View updates <i class="fa fa-arrow-right"></i></span>
                  </div>
                <% end %>
                <%= button_to favourite_path(@favourites_by_game_id[game.id]),
                      method: :delete,
                      class: "game-card-wrapper__remove",
                      form: { data: { turbo_confirm: "Remove #{game.name} from your games?" } },
                      title: "Remove from My Games" do %>
                  <i class="fa fa-times"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="my-games-page__empty">
            <div class="my-games-page__empty-icon">
              <i class="fa fa-gamepad"></i>
            </div>
            <h2 class="my-games-page__empty-title">You have not favourited any games yet</h2>
            <p class="my-games-page__empty-copy">Favourite games to build your personal dashboard for patches, events, and reminders.</p>
            <%= link_to games_path, class: "my-games-page__action my-games-page__action--primary" do %>
              <i class="fa fa-search"></i>
              Browse Games
            <% end %>
          </div>
        <% end %>
      </div>
    </div><%# /games-panel %>

  </main>
</div>

<script>
  document.addEventListener('turbo:load', function () {
    // ── Games panel toggle ─────────────────────────────────────────────────────
    var gamesTabBtn  = document.querySelector('[data-games-tab-toggle]');
    var socialPanel  = document.getElementById('social-panel');
    var gamesPanel   = document.getElementById('games-panel');
    var backBtn      = document.getElementById('games-panel-back');
    var gamesActive  = false;

    function showGames() {
      gamesActive = true;
      socialPanel.style.display = 'none';
      gamesPanel.style.display  = 'block';
      gamesTabBtn.style.outline = '2px solid var(--gb-accent, #7c5cfc)';
      gamesTabBtn.style.outlineOffset = '2px';
    }

    function showFeed() {
      gamesActive = false;
      socialPanel.style.display = '';
      gamesPanel.style.display  = 'none';
      gamesTabBtn.style.outline = '';
      gamesTabBtn.style.outlineOffset = '';
    }

    if (gamesTabBtn && socialPanel && gamesPanel) {
      gamesTabBtn.addEventListener('click', function () {
        gamesActive ? showFeed() : showGames();
      });
    }

    if (backBtn) {
      backBtn.addEventListener('click', showFeed);
    }

    document.querySelectorAll('.like-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        btn.classList.add('heart-pop');
        btn.querySelector('i').addEventListener('animationend', function () {
          btn.classList.remove('heart-pop');
        }, { once: true });
      });
    });
  });
</script>

<!-- Friends Modal -->
<div class="modal" id="friendsModal" tabindex="-1" aria-labelledby="friendsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 400px;">
    <div class="modal-content" style="background: var(--gb-surface, #13162a); border: 1px solid rgba(124,92,252,0.25); border-radius: 18px; color: var(--gb-text, #e8eaf6);">
      <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.08); padding: 16px 20px;">
        <h5 class="modal-title" id="friendsModalLabel" style="font-size: 1rem; font-weight: 700;">
          Friends · <%= current_user.friends.count %>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="padding: 12px 16px;">
        <% if @pending_requests.any? %>
          <p style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted, #8891b4); margin: 0 4px 8px;">Requests (<%= @pending_requests.count %>)</p>
          <% @pending_requests.each do |req| %>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 4px; border-bottom: 1px solid rgba(255,255,255,0.05);"
                 id="modal-pending-<%= req.id %>"
                 data-user-path="<%= user_path(req.user) %>"
                 data-user-name="<%= req.user.display_name %>"
                 data-user-handle="<%= req.user.profile_handle %>"
                 data-user-initial="<%= req.user.display_name.first.upcase %>">
              <div class="modal-friend-row" data-profile-id="<%= req.user.id %>" style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; cursor: pointer;">
                <div style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent, #7c5cfc), #4f9cf9); display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; color: #fff; flex-shrink: 0; overflow: hidden;">
                  <% if req.user.avatar_image.attached? %>
                    <%= image_tag req.user.avatar_image, style: "width: 100%; height: 100%; object-fit: cover;" %>
                  <% elsif req.user.avatar_url.present? %>
                    <%= image_tag req.user.avatar_url, style: "width: 100%; height: 100%; object-fit: cover;" %>
                  <% else %>
                    <%= req.user.display_name.first.upcase %>
                  <% end %>
                </div>
                <div style="min-width: 0;">
                  <div style="font-size: 0.88rem; font-weight: 700; color: var(--gb-text, #e8eaf6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= req.user.display_name %></div>
                  <div style="font-size: 0.75rem; color: var(--gb-muted, #8891b4);">@<%= req.user.profile_handle %></div>
                </div>
              </div>
              <div style="display: flex; gap: 4px; flex-shrink: 0;">
                <button class="ff-modal-action-btn modal-pending-accept" data-friendship-id="<%= req.id %>" data-card="modal-pending-<%= req.id %>" style="border-color: #22c55e; background: rgba(34,197,94,0.2); color: #22c55e;" title="Accept"><i class="fa fa-check"></i></button>
                <button class="ff-modal-action-btn modal-pending-decline" data-friendship-id="<%= req.id %>" data-card="modal-pending-<%= req.id %>" style="border-color: rgba(255,80,80,0.4); color: rgba(255,80,80,0.7);" title="Decline"><i class="fa fa-times"></i></button>
              </div>
            </div>
          <% end %>
          <div style="margin: 12px 4px 8px; border-top: 1px solid rgba(255,255,255,0.06);"></div>
          <p style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted, #8891b4); margin: 8px 4px 8px;">Friends (<%= @friends.count %>)</p>
        <% end %>
        <%# Card pane — shown when a friend row is clicked -%>
        <div id="modal-card-pane" style="display: none;">
          <button id="modal-card-back" type="button" style="display: inline-flex; align-items: center; gap: 6px; background: none; border: none; color: var(--gb-muted, #8891b4); font-size: 0.82rem; cursor: pointer; padding: 0 0 12px; font-family: inherit;">
            <i class="fa fa-arrow-left"></i> Back to friends
          </button>
          <div id="modal-card-content"></div>
        </div>

        <div id="modal-friends-list">
          <% if @friends.any? %>
            <% @friends.each do |friend| %>
              <div style="display: flex; align-items: center; gap: 12px; padding: 10px 4px; border-bottom: 1px solid rgba(255,255,255,0.05);">
                <div class="modal-friend-row" data-profile-id="<%= friend.id %>" style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; cursor: pointer;">
                  <div style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent, #7c5cfc), #4f9cf9); display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; color: #fff; flex-shrink: 0; overflow: hidden;">
                    <% if friend.avatar_image.attached? %>
                      <%= image_tag friend.avatar_image, style: "width: 100%; height: 100%; object-fit: cover;" %>
                    <% elsif friend.avatar_url.present? %>
                      <%= image_tag friend.avatar_url, style: "width: 100%; height: 100%; object-fit: cover;" %>
                    <% else %>
                      <%= friend.display_name.first.upcase %>
                    <% end %>
                  </div>
                  <div style="min-width: 0;">
                    <div style="font-size: 0.88rem; font-weight: 700; color: var(--gb-text, #e8eaf6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= friend.display_name %></div>
                    <div style="font-size: 0.75rem; color: var(--gb-muted, #8891b4);">@<%= friend.profile_handle %></div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p id="modal-no-friends" style="font-size: 0.85rem; color: var(--gb-muted, #8891b4); text-align: center; padding: 24px 0; margin: 0;">
              No friends yet. <%= link_to "Find some!", find_friends_path, style: "color: var(--gb-accent, #7c5cfc);" %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Find Friends Modal -->
<div class="modal" id="findFriendsModal" tabindex="-1" aria-labelledby="findFriendsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 420px;">
    <div class="modal-content" style="background: var(--gb-surface, #13162a); border: 1px solid rgba(124,92,252,0.25); border-radius: 18px; color: var(--gb-text, #e8eaf6);">
      <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.08); padding: 16px 20px;">
        <h5 class="modal-title" id="findFriendsModalLabel" style="font-size: 1rem; font-weight: 700;">Find Friends</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="padding: 16px;">
        <div style="position: relative; margin-bottom: 12px;">
          <input type="text" id="ffModalInput" placeholder="Search by username…" autocomplete="off"
            style="width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(124,92,252,0.3); border-radius: 999px; padding: 10px 40px 10px 16px; color: var(--gb-text, #e8eaf6); font-size: 0.88rem; outline: none;">
          <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--gb-muted, #8891b4); pointer-events: none;">
            <i class="fa fa-search"></i>
          </span>
        </div>
        <div id="ffModalResults"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // ── Friends modal — profile card pane ────────────────────────────────────────
  (function () {
    var friendsList = document.getElementById('modal-friends-list');
    var cardPane    = document.getElementById('modal-card-pane');
    var cardContent = document.getElementById('modal-card-content');
    var backBtn     = document.getElementById('modal-card-back');

    if (!friendsList || !cardPane || !cardContent || !backBtn) return;

    // Reset to list view whenever the modal opens
    document.getElementById('friendsModal').addEventListener('show.bs.modal', function () {
      cardPane.style.display    = 'none';
      friendsList.style.display = 'block';
    });

    // Delegate clicks on friend rows
    document.getElementById('friendsModal').addEventListener('click', function (e) {
      if (e.target.closest('#modal-card-back')) return; // handled below
      if (e.target.closest('.ff-modal-action-btn, .modal-pending-accept, .modal-pending-decline')) return;
      var row = e.target.closest('.modal-friend-row[data-profile-id]');
      if (!row) return;

      // Show loading state in card pane
      friendsList.style.display = 'none';
      cardPane.style.display    = 'block';
      cardContent.innerHTML =
        '<div style="padding: 2rem; text-align: center; color: var(--gb-muted, #8891b4);">' +
          '<i class="fa fa-circle-o-notch fa-spin fa-lg"></i>' +
        '</div>';

      fetch('/users/' + row.dataset.profileId + '/card', {
        headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        // Strip the close button — not needed inside the modal
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var closeBtn = tmp.querySelector('#ffCardClose');
        if (closeBtn) closeBtn.remove();
        cardContent.innerHTML = tmp.innerHTML;
        wireCardFriendBtns(cardContent);
      });
    });

    // Back button
    backBtn.addEventListener('click', function () {
      cardPane.style.display    = 'none';
      friendsList.style.display = 'block';
    });

    function wireCardFriendBtns(scope) {
      var csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      scope.querySelectorAll('.card-friend-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var action = btn.dataset.action;
          var userId = btn.dataset.userId;
          var fid    = btn.dataset.friendshipId;

          if (action === 'add') {
            fetch('/friendships', {
              method: 'POST',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify({ friend_id: userId })
            }).then(function (r) { return r.json(); }).then(function (data) {
              btn.dataset.action = 'cancel';
              btn.dataset.friendshipId = data.friendship_id;
              btn.classList.remove('social-profile-action--primary');
              btn.innerHTML = '<i class="fa fa-clock-o me-1"></i> Pending';
            });
          } else if (action === 'cancel' || action === 'unfriend') {
            fetch('/friendships/' + fid, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function () {
              btn.dataset.action = 'add';
              btn.dataset.friendshipId = '';
              btn.classList.add('social-profile-action--primary');
              btn.innerHTML = '<i class="fa fa-plus me-1"></i> Add Friend';
            });
          } else if (action === 'accept') {
            fetch('/friendships/' + fid, {
              method: 'PATCH',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function (r) { return r.json(); }).then(function (data) {
              var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
              wrap.outerHTML =
                '<button class="social-profile-action social-profile-action--full card-friend-btn"' +
                  ' data-action="unfriend" data-user-id="' + userId + '"' +
                  ' data-friendship-id="' + data.friendship_id + '">' +
                  '<i class="fa fa-check me-1"></i> Friends</button>';
              wireCardFriendBtns(scope);
            });
          } else if (action === 'decline') {
            fetch('/friendships/' + fid, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function () {
              var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
              wrap.outerHTML =
                '<button class="social-profile-action social-profile-action--primary social-profile-action--full card-friend-btn"' +
                  ' data-action="add" data-user-id="' + userId + '">' +
                  '<i class="fa fa-plus me-1"></i> Add Friend</button>';
              wireCardFriendBtns(scope);
            });
          }
        });
      });

      wireProfileCardTabs(scope);
    }

    function wireProfileCardTabs(container) {
      var nav = container.querySelector('.pub-profile-tab-nav');
      if (!nav) return;
      var tabs = nav.querySelectorAll('.pub-profile-tab[data-tab]');
      var panelContainer = container.querySelector('.pub-profile-tab-panels');
      if (!panelContainer) return;
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.dataset.tab;
          tabs.forEach(function (t) {
            var active = t.dataset.tab === target;
            t.style.borderBottomColor = active ? 'var(--gb-accent)' : 'transparent';
          });
          panelContainer.querySelectorAll('[data-panel]').forEach(function (p) {
            p.style.display = p.dataset.panel === target ? '' : 'none';
          });
        });
      });
    }
  })();

  // Wire up accept/decline buttons inside the Friends modal
  (function () {
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    document.querySelectorAll('.modal-pending-accept').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var friendshipId = btn.dataset.friendshipId;
        var cardId = btn.dataset.card;
        var card = document.getElementById(cardId);
        var userPath    = card ? card.dataset.userPath    : '#';
        var userName    = card ? card.dataset.userName    : '';
        var userHandle  = card ? card.dataset.userHandle  : '';
        var userInitial = card ? card.dataset.userInitial : '';

        fetch('/friendships/' + friendshipId, {
          method: 'PATCH',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          if (card) card.remove();
          updatePendingSection();
          addFriendCard(userPath, userName, userHandle, userInitial);
          updateFriendCount(1);
        });
      });
    });

    document.querySelectorAll('.modal-pending-decline').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var friendshipId = btn.dataset.friendshipId;
        var cardId = btn.dataset.card;
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          var card = document.getElementById(cardId);
          if (card) card.remove();
          updatePendingSection();
        });
      });
    });

    function updatePendingSection() {
      var modal = document.getElementById('friendsModal');
      if (!modal) return;
      var remaining = modal.querySelectorAll('[id^="modal-pending-"]').length;
      if (remaining === 0) {
        modal.querySelectorAll('.modal-body > p').forEach(function (p) {
          if (p.textContent.includes('Requests') || p.textContent.includes('Friends (')) p.remove();
        });
        modal.querySelectorAll('.modal-body > div[style*="border-top"]').forEach(function (d) { d.remove(); });
      }
      // Update the pending badge on the stat button
      var badge = document.querySelector('.pending-badge');
      if (badge) {
        if (remaining === 0) {
          badge.remove();
        } else {
          badge.textContent = remaining;
        }
      }
    }

    function addFriendCard(userPath, userName, userHandle, userInitial) {
      var list = document.getElementById('modal-friends-list');
      if (!list) return;
      // Remove "no friends" placeholder if present
      var placeholder = document.getElementById('modal-no-friends');
      if (placeholder) placeholder.remove();
      var row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;gap:12px;padding:10px 4px;border-bottom:1px solid rgba(255,255,255,0.05);';
      row.innerHTML =
        '<a href="' + userPath + '" style="display:flex;align-items:center;gap:12px;flex:1;min-width:0;text-decoration:none;">' +
          '<div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gb-accent,#7c5cfc),#4f9cf9);display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:700;color:#fff;flex-shrink:0;">' + userInitial + '</div>' +
          '<div style="min-width:0;">' +
            '<div style="font-size:0.88rem;font-weight:700;color:var(--gb-text,#e8eaf6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + userName + '</div>' +
            '<div style="font-size:0.75rem;color:var(--gb-muted,#8891b4);">@' + userHandle + '</div>' +
          '</div>' +
        '</a>';
      list.appendChild(row);
    }

    function updateFriendCount(delta) {
      // Update modal title
      var title = document.getElementById('friendsModalLabel');
      if (title) {
        var current = parseInt(title.textContent.match(/\d+/) || [0], 10);
        title.textContent = 'Friends \u00b7 ' + (current + delta);
      }
      // Update the stat button on the profile
      var statBtn = document.querySelector('[data-bs-target="#friendsModal"] .social-stat__count');
      if (statBtn) {
        var n = parseInt(statBtn.textContent.match(/\d+/) || [0], 10) + delta;
        statBtn.textContent = n + (n === 1 ? ' Friend' : ' Friends');
      }
    }
  })();

  (function () {
    var modal   = document.getElementById('findFriendsModal');
    var input   = document.getElementById('ffModalInput');
    var results = document.getElementById('ffModalResults');
    var timer   = null;
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    if (!modal || !input || !results) return;

    modal.addEventListener('hidden.bs.modal', function () {
      input.value = '';
      results.innerHTML = '';
    });

    modal.addEventListener('shown.bs.modal', function () {
      input.focus();
    });

    input.addEventListener('input', function () {
      clearTimeout(timer);
      var q = input.value.trim();
      if (!q) { results.innerHTML = ''; return; }

      timer = setTimeout(function () {
        fetch('<%= find_friends_path %>.json?q=' + encodeURIComponent(q), {
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (users) { renderResults(users); });
      }, 250);
    });

    function renderResults(users) {
      if (!users.length) {
        results.innerHTML = '<p style="font-size:0.82rem;color:var(--gb-muted,#8891b4);text-align:center;padding:16px 0;margin:0;">No users found.</p>';
        return;
      }
      var html = '<div style="display:flex;flex-direction:column;gap:4px;">';
      users.forEach(function (u) {
        var btnHtml = '';
        if (u.pending_sent) {
          btnHtml = '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.friendship_id + '" data-action="cancel" style="border-color:rgba(255,255,255,0.2);color:var(--gb-muted,#8891b4);" title="Cancel request"><i class="fa fa-paper-plane"></i></button>';
        } else if (u.pending_received) {
          btnHtml =
            '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.incoming_request_id + '" data-action="accept" style="border-color:var(--gb-accent,#7c5cfc);background:rgba(124,92,252,0.2);color:var(--gb-accent,#7c5cfc);" title="Accept"><i class="fa fa-check"></i></button>' +
            '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.incoming_request_id + '" data-action="decline" style="border-color:rgba(255,80,80,0.4);color:rgba(255,80,80,0.7);" title="Decline"><i class="fa fa-times"></i></button>';
        } else if (u.is_friend) {
          btnHtml = '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.friendship_id + '" data-action="unfriend" style="border-color:var(--gb-accent,#7c5cfc);background:rgba(124,92,252,0.2);color:var(--gb-accent,#7c5cfc);" title="Remove friend"><i class="fa fa-check"></i></button>';
        } else {
          btnHtml = '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-action="add" style="border-color:rgba(255,255,255,0.2);color:var(--gb-muted,#8891b4);" title="Send friend request"><i class="fa fa-plus"></i></button>';
        }
        html +=
          '<div style="display:flex;align-items:center;gap:10px;padding:8px 4px;border-bottom:1px solid rgba(255,255,255,0.05);" id="modal-card-' + u.id + '">' +
            '<a href="/users/' + u.id + '" style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;text-decoration:none;">' +
              '<div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--gb-accent,#7c5cfc),#4f9cf9);display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:#fff;flex-shrink:0;">' + escHtml(u.initial) + '</div>' +
              '<div style="flex:1;min-width:0;">' +
                '<div style="font-size:0.85rem;font-weight:700;color:var(--gb-text,#e8eaf6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + escHtml(u.display) + '</div>' +
                (u.email ? '<div style="font-size:0.73rem;color:var(--gb-muted,#8891b4);">' + escHtml(u.email) + '</div>' : '') +
              '</div>' +
            '</a>' +
            '<div style="display:flex;gap:4px;flex-shrink:0;">' + btnHtml + '</div>' +
          '</div>';
      });
      html += '</div>';
      results.innerHTML = html;

      results.querySelectorAll('.ff-modal-action-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { handleAction(this); });
      });
    }

    function handleAction(btn) {
      var action       = btn.dataset.action;
      var userId       = btn.dataset.userId;
      var friendshipId = btn.dataset.friendshipId;

      if (action === 'add') {
        fetch('/friendships', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ friend_id: userId })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          btn.dataset.action = 'cancel';
          btn.dataset.friendshipId = data.friendship_id;
          btn.title = 'Cancel request';
          btn.innerHTML = '<i class="fa fa-paper-plane"></i>';
          btn.style.borderColor = 'rgba(255,255,255,0.2)';
          btn.style.color = 'var(--gb-muted,#8891b4)';
          btn.style.background = 'transparent';
        });

      } else if (action === 'cancel') {
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          btn.dataset.action = 'add';
          btn.dataset.friendshipId = '';
          btn.title = 'Send friend request';
          btn.innerHTML = '<i class="fa fa-plus"></i>';
        });

      } else if (action === 'accept') {
        fetch('/friendships/' + friendshipId, {
          method: 'PATCH',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var wrap = btn.closest('div[style*="flex-shrink"]');
          if (wrap) {
            wrap.innerHTML = '<button class="ff-modal-action-btn" data-action="unfriend" data-user-id="' + userId + '" data-friendship-id="' + data.friendship_id + '" style="border-color:var(--gb-accent,#7c5cfc);background:rgba(124,92,252,0.2);color:var(--gb-accent,#7c5cfc);" title="Remove friend"><i class="fa fa-check"></i></button>';
            wrap.querySelector('.ff-modal-action-btn').addEventListener('click', function () { handleAction(this); });
          }
        });

      } else if (action === 'decline') {
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          var wrap = btn.closest('div[style*="flex-shrink"]');
          if (wrap) {
            wrap.innerHTML = '<button class="ff-modal-action-btn" data-action="add" data-user-id="' + userId + '" style="border-color:rgba(255,255,255,0.2);color:var(--gb-muted,#8891b4);" title="Send friend request"><i class="fa fa-plus"></i></button>';
            wrap.querySelector('.ff-modal-action-btn').addEventListener('click', function () { handleAction(this); });
          }
        });

      } else if (action === 'unfriend') {
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          btn.dataset.action = 'add';
          btn.dataset.friendshipId = '';
          btn.title = 'Send friend request';
          btn.innerHTML = '<i class="fa fa-plus"></i>';
          btn.style.borderColor = 'rgba(255,255,255,0.2)';
          btn.style.color = 'var(--gb-muted,#8891b4)';
          btn.style.background = 'transparent';
        });
      }
    }

    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  })();
</script>

<style>
  .ff-modal-action-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    transition: opacity 0.15s;
  }
  .ff-modal-action-btn:hover { opacity: 0.75; }

  /* ── Games panel — scoped layout overrides ─────────────────────── */
  #games-panel .my-games-page {
    padding: 0 0 2rem !important;
  }
  #games-panel .my-games-page__header {
    margin: 0 !important;
    padding: 1.25rem 1.5rem !important;
  }
  #games-panel .my-games-page__grid {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
    padding: 1.25rem 1.5rem !important;
    gap: 1rem !important;
  }
  #games-panel .my-games-page__empty {
    padding: 1.5rem !important;
  }

  /* ── Game card — uniform height ─────────────────────────────────── */
  #games-panel .game-card {
    display: block;
    position: relative;
  }
  #games-panel .game-card__cover {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: inherit;
  }
  #games-panel .game-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #games-panel .game-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    color: var(--gb-muted);
    font-size: 2.25rem;
  }
  #games-panel .game-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.1) 50%, transparent 100%);
    pointer-events: none;
  }
  #games-panel .game-card__body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.6rem 0.75rem 0.7rem;
    z-index: 2;
  }
  #games-panel .game-card__name {
    margin: 0 0 0.2rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #games-panel .game-card__cta {
    display: none;
  }
</style>
