<% content_for :title, "My Profile" %>
<meta name="turbo-cache-control" content="no-cache">

<%

  profile_name   = current_user.display_name
  profile_handle = current_user.profile_handle
  profile_highlights = [
    { label: "Favourited games", value: @followed_games.count, icon: "fa-gamepad",   url: my_profile_path, toggle_games: true },
    { label: "Patch drops",      value: @recent_patches.count, icon: "fa-file-text", url: my_profile_path, toggle_patches: true },
    { label: "Event reminders",  value: @reminders.count,      icon: "fa-calendar",  url: my_profile_path, toggle_events: true }
  ]
  next_reminder = @reminders.first
  latest_patch = @recent_patches.first
%>

<div class="container my-profile-layout" data-controller="notification-toggles">

  <!-- Sidebar -->
  <%= render "shared/profile_sidebar", active: :profile %>

  <!-- Social main -->
  <main class="social-main" data-controller="social-feed">

    <!-- Profile header -->
    <div class="social-profile-header">
      <% banner_style = current_user.cover_image.attached? ? "background-image: linear-gradient(rgba(7, 10, 22, 0.18), rgba(7, 10, 22, 0.52)), url('#{url_for(current_user.cover_image)}');" : nil %>
      <div class="social-profile-banner"<%= banner_style.present? ? " style=\"#{banner_style}\"".html_safe : "" %>>
        <%= form_with url: user_registration_path, method: :patch, multipart: true, class: "banner-upload-form" do |f| %>
          <%= f.hidden_field :email, value: current_user.email %>
          <%= f.file_field :cover_image, id: "banner-cover-input", accept: "image/*", style: "display:none", onchange: "this.form.submit()" %>
        <% end %>
        <label for="banner-cover-input" class="banner-edit-btn" title="Modifier la bannière">
          <i class="fa fa-pencil"></i>
        </label>
      </div>
      <div class="social-profile-info">
        <div class="social-profile-top-row">
          <div class="social-profile-avatar-wrap">
            <% if current_user.avatar_image.attached? %>
              <%= image_tag current_user.avatar_image, class: "social-profile-avatar social-profile-avatar--img" %>
            <% elsif current_user.avatar_url.present? %>
              <%= image_tag current_user.avatar_url, class: "social-profile-avatar social-profile-avatar--img" %>
            <% else %>
              <div class="social-profile-avatar">
                <%= current_user.email.first.upcase %>
              </div>
            <% end %>
            <%= form_with url: user_registration_path, method: :patch, multipart: true, class: "avatar-upload-form" do |f| %>
              <%= f.hidden_field :email, value: current_user.email %>
              <%= f.file_field :avatar_image, id: "avatar-image-input", accept: "image/*", style: "display:none", onchange: "this.form.submit()" %>
            <% end %>
            <label for="avatar-image-input" class="avatar-edit-btn" title="Modifier la photo de profil">
              <i class="fa fa-pencil"></i>
            </label>
          </div>
          <div class="profile-action-btns">
            <%= link_to "Edit Profile", edit_user_registration_path, class: "btn-edit-profile" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_dashboard_path, class: "btn-edit-profile btn-admin-panel" %>
            <% end %>
          </div>
        </div>

        <div class="social-profile-identity">
          <h2 class="social-profile-name"><%= profile_name %></h2>
          <div class="social-profile-meta">
            <span class="social-profile-handle">@<%= profile_handle %></span>
            <% if current_user.hometown.present? %>
              <span class="social-profile-meta__sep"></span>
              <span class="social-profile-meta__hometown">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= current_user.hometown %>
              </span>
            <% end %>
          </div>
        </div>
        <% if current_user.bio.present? %>
          <p class="social-profile-bio"><%= current_user.bio %></p>
        <% end %>
        <div class="social-profile-stats">
          <button type="button" class="social-stat" data-bs-toggle="modal" data-bs-target="#friendsModal">
            <span class="social-stat__count"><%= current_user.friends.count %> <%= current_user.friends.count == 1 ? "Friend" : "Friends" %></span>
            <% if @pending_received_count > 0 %>
              <span class="pending-badge" title="<%= @pending_received_count %> pending friend <%= @pending_received_count == 1 ? 'request' : 'requests' %>">
                <i class="fa fa-user-plus" style="font-size: 0.6rem;"></i>
                <%= @pending_received_count %>
              </span>
            <% end %>
          </button>
          <button type="button" class="social-stat" data-bs-toggle="modal" data-bs-target="#findFriendsModal">
            <span class="social-stat__count"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></span>
            <span class="social-stat__count">Find Friends</span>
          </button>
        </div>
        <button type="button" id="back-to-feed-btn" style="display:none; align-items: center; gap: 6px; background: none; border: none; color: var(--gb-muted); font-size: 0.82rem; cursor: pointer; padding: 0 0 0.5rem; font-family: inherit; transition: color 0.15s;" onmouseover="this.style.color='var(--gb-text)'" onmouseout="this.style.color='var(--gb-muted)'">
          <i class="fa fa-arrow-left"></i> Back to Feed
        </button>
        <nav class="profile-subnav">
          <button type="button" id="games-tab-btn" class="profile-subnav__tab" data-games-tab-toggle>
            <i class="fa fa-gamepad"></i>
            Favourited games
            <span class="profile-subnav__badge"><%= @followed_games.count %></span>
          </button>
          <button type="button" id="patches-tab-btn" class="profile-subnav__tab" data-patches-tab-toggle>
            <i class="fa fa-file-text"></i>
            Patch drops
            <span class="profile-subnav__badge"><%= @recent_patches.count %></span>
          </button>
          <button type="button" id="events-tab-btn" class="profile-subnav__tab" data-events-tab-toggle>
            <i class="fa fa-calendar"></i>
            Event reminders
            <span class="profile-subnav__badge"><%= @reminders.count %></span>
          </button>
        </nav>
      </div>
    </div>

    <div id="social-panel">
    <div class="for-you-layout">
      <div class="for-you-feed">

        <%# Top actions bar %>
        <div class="px-3 pt-3 pb-2 d-flex justify-content-between align-items-center">
          <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted); margin: 0;">FriendHub</p>
          <div class="d-flex gap-2 align-items-center">
<button id="new-post-btn" class="compose-btn" style="display: none;" onclick="document.getElementById('new-post-form').style.display='block'; this.style.display='none';">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Post
            </button>
          </div>
        </div>

        <%# New post form (visible by default) %>
        <div id="new-post-form" class="compose-form-wrapper">
          <%= form_with url: posts_path, scope: :post do |f| %>
            <div class="compose-form__avatar">
              <% if current_user.avatar_image.attached? %>
                <%= image_tag current_user.avatar_image, class: "compose-form__avatar-img" %>
              <% else %>
                <div class="compose-form__avatar-placeholder"><%= current_user.display_name.first.upcase %></div>
              <% end %>
            </div>
            <div class="compose-form__body">
              <%= f.text_area :body, placeholder: "What's on your mind?", rows: 2, class: "compose-form__textarea", autofocus: true %>
              <div class="compose-form__actions">
                <button type="button" class="compose-form__cancel" onclick="document.getElementById('new-post-form').style.display='none'; document.getElementById('new-post-btn').style.display='inline-flex';">Cancel</button>
                <%= f.submit "Post", class: "compose-form__submit" %>
              </div>
            </div>
          <% end %>
        </div>

        <%# Posts feed %>
        <div class="p-3" style="display: flex; flex-direction: column; gap: 10px;">
          <% if @feed_posts.any? %>
            <% @feed_posts.each do |post| %>
              <% liked = post.likes.exists?(user: current_user) %>
              <div style="border-radius: 18px; border: 1px solid rgba(124,92,252,0.25); overflow: hidden; background: rgba(255,255,255,0.02);">
                <%# Post header %>
                <div style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: linear-gradient(135deg, rgba(124,92,252,0.15), rgba(79,156,249,0.08)); border-bottom: 1px solid rgba(255,255,255,0.06);">
                  <div class="feed-profile-trigger" data-profile-id="<%= post.user.id %>" style="width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent), var(--gb-accent-strong)); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: #fff; flex-shrink: 0; overflow: hidden; cursor: pointer;">
                    <% if post.user.avatar_image.attached? %>
                      <%= image_tag post.user.avatar_image, style: "width: 100%; height: 100%; object-fit: cover;" %>
                    <% else %>
                      <%= post.user.display_name.first.upcase %>
                    <% end %>
                  </div>
                  <span class="feed-profile-trigger" data-profile-id="<%= post.user.id %>" style="font-size: 0.85rem; font-weight: 700; color: var(--gb-text); cursor: pointer;"><%= post.user.display_name %></span>
                  <span style="color: var(--gb-muted); font-size: 0.72rem; margin-left: auto;"><%= time_ago_in_words(post.created_at) %> ago</span>
                  <% if post.user == current_user %>
                    <%= button_to post_path(post), method: :delete, class: "btn btn-link btn-sm p-0 ms-1", style: "color: rgba(255,255,255,0.2); font-size: 0.72rem; line-height: 1;", form: { data: { turbo_confirm: "Delete this post?" } } do %>
                      <i class="fa fa-trash"></i>
                    <% end %>
                  <% end %>
                </div>
                <%# Post body %>
                <div style="padding: 12px 14px 8px;">
                  <p style="margin: 0 0 10px; font-size: 0.88rem; color: var(--gb-text); line-height: 1.6;"><%= post.body %></p>
                  <%# Rocket reaction %>
                  <div style="display: flex; align-items: center; gap: 4px;">
                    <% if liked %>
                      <%= button_to post_like_path(post, post.likes.find_by(user: current_user)), method: :delete, class: "like-btn liked", title: "Un-rocket" do %>
                        <i class="fa fa-rocket"></i>
                      <% end %>
                    <% else %>
                      <%= button_to post_likes_path(post), method: :post, class: "like-btn", title: "Rocket!" do %>
                        <i class="fa fa-rocket"></i>
                      <% end %>
                    <% end %>
                    <span class="like-count"><%= post.likes.count %></span>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted" style="font-size: 0.85rem;">No posts yet. Give your opinion!</p>
          <% end %>
        </div>

        <div class="px-3 pb-3"></div>
      </div>

      <aside class="for-you-sidebar">
        <section id="my-events" class="profile-rail-card">
          <div class="profile-rail-card__header">
            <h3 class="profile-rail-card__title">Upcoming Event</h3>
            <%= link_to "All events", my_profile_path, class: "profile-rail-card__link" %>
          </div>
          <% if next_reminder.present? %>
            <%= link_to event_path(next_reminder.event), class: "profile-rail-feature" do %>
              <span class="profile-rail-feature__eyebrow"><%= next_reminder.event.game.name %></span>
              <h4 class="profile-rail-feature__title"><%= next_reminder.event.title %></h4>
              <p class="profile-rail-feature__meta">
                <i class="fa fa-calendar"></i>
                <%= next_reminder.event.start_date&.strftime("%-d %b %Y") || "Date TBD" %>
              </p>
            <% end %>
          <% else %>
            <p class="profile-rail-card__empty">No reminders set yet. <%= link_to "Browse events", events_path %>.</p>
          <% end %>
        </section>

        <section id="my-patches" class="profile-rail-card">
          <div class="profile-rail-card__header">
            <h3 class="profile-rail-card__title">Latest Patch</h3>
            <%= link_to "View patches", my_profile_path, class: "profile-rail-card__link" %>
          </div>
          <% if latest_patch.present? %>
            <%= link_to patch_path(latest_patch), class: "profile-rail-feature" do %>
              <span class="profile-rail-feature__eyebrow"><%= latest_patch.game.name %></span>
              <h4 class="profile-rail-feature__title"><%= latest_patch.title %></h4>
              <p class="profile-rail-feature__meta">
                <i class="fa fa-clock-o"></i>
                <%= latest_patch.display_published_at.to_date.to_fs(:long) %>
              </p>
            <% end %>
          <% else %>
            <p class="profile-rail-card__empty">No recent patches for your favourited games.</p>
          <% end %>
        </section>
      </aside>
    </div>
    </div><%# /social-panel %>

    <%# Games panel — shown when Favourited Games button is clicked %>
    <div id="games-panel" style="display: none;">
      <div class="my-games-page">
        <div class="my-games-page__header">
          <div class="my-games-page__heading">
            <h1 class="my-games-page__title">My Games</h1>
            <p class="my-games-page__subtitle">Favourited games, all in one place.</p>
          </div>
        </div>

        <% if @games.any? %>
          <div class="my-games-page__grid">
            <% @games.each do |game| %>
              <div class="game-card-wrapper">
                <%= link_to game_path(game, return_to: my_profile_path), class: "game-card event-glow-card" do %>
                  <div class="game-card__cover">
                    <% if game.cover_image.present? %>
                      <%= image_tag game.cover_image, alt: game.name, class: "game-card__img", loading: "lazy" %>
                    <% else %>
                      <div class="game-card__placeholder">
                        <i class="fa fa-gamepad"></i>
                      </div>
                    <% end %>
                    <div class="game-card__overlay"></div>
                  </div>
                  <div class="game-card__body">
                    <h3 class="game-card__name"><%= game.name %></h3>
                    <span class="game-card__cta">View updates <i class="fa fa-arrow-right"></i></span>
                  </div>
                <% end %>
                <%= button_to favourite_path(@favourites_by_game_id[game.id]),
                      method: :delete,
                      class: "game-card-wrapper__remove",
                      form: { data: { turbo_confirm: "Remove #{game.name} from your games?" } },
                      title: "Remove from My Games" do %>
                  <i class="fa fa-times"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="my-games-page__empty">
            <div class="my-games-page__empty-icon">
              <i class="fa fa-gamepad"></i>
            </div>
            <h2 class="my-games-page__empty-title">You have not favourited any games yet</h2>
            <p class="my-games-page__empty-copy">Favourite games to build your personal dashboard for patches, events, and reminders.</p>
            <%= link_to games_path, class: "my-games-page__action my-games-page__action--primary" do %>
              <i class="fa fa-search"></i>
              Browse Games
            <% end %>
          </div>
        <% end %>
      </div>
    </div><%# /games-panel %>

    <%# Patches panel — shown when Patch Drops button is clicked %>
    <div id="patches-panel" style="display: none;">
      <div class="my-patches-page">
        <div class="my-patches-page__header">
          <div class="my-patches-page__heading">
            <h1 class="my-patches-page__title">My Patch Updates</h1>
            <p class="my-patches-page__subtitle">Recent patch notes from your favourited games.</p>
          </div>
        </div>

        <% if @recent_patches.any? %>
          <div style="display: flex; justify-content: flex-end; padding: 0 0 0.5rem;">
            <button type="button" class="filter-btn" id="profile-organise-btn" onclick="toggleProfilePatchView()">
              <i class="fa fa-filter"></i> Organise by game
            </button>
          </div>
          <div class="profile-rail-card" style="padding: 1.25rem;">
            <div id="profile-patches-flat">
              <% @recent_patches.each do |patch| %>
                <%= link_to patch_path(patch, return_to: my_profile_path), class: "patch-list-card" do %>
                  <div class="patch-list-card__icon">
                    <% if patch.game.cover_image.present? %>
                      <%= image_tag patch.game.cover_image, alt: patch.game.name, style: "width:36px;height:48px;object-fit:cover;border-radius:0.3rem;" %>
                    <% else %>
                      <i class="fa fa-file-text-o"></i>
                    <% end %>
                  </div>
                  <span class="patch-list-card__title">
                    <small class="d-block text-muted mb-0" style="font-size:0.78rem; font-weight:600;"><%= patch.game.name %></small>
                    <%= patch.title %>
                    <span class="patch-list-card__meta">
                      <small class="d-block text-muted mb-0"><%= patch.display_published_at.to_date.to_fs(:long) %></small>
                      <% if patch.freshly_published? %>
                        <span class="patch-fresh-badge">New</span>
                      <% end %>
                    </span>
                  </span>
                  <span class="patch-list-card__arrow"><i class="fa fa-chevron-right"></i></span>
                <% end %>
              <% end %>
            </div>

            <div id="profile-patches-by-game" style="display:none;">
              <div class="patch-show__accordions">
                <% @recent_patches.group_by(&:game).each do |game, patches| %>
                  <details class="patch-show__accordion">
                    <summary class="patch-show__accordion-summary" style="flex-direction:row;align-items:center;gap:0.75rem;">
                      <% if game.cover_image.present? %>
                        <%= image_tag game.cover_image, alt: game.name, style: "width:36px;height:48px;object-fit:cover;border-radius:0.3rem;flex-shrink:0;" %>
                      <% end %>
                      <div style="display:flex;flex-direction:column;gap:0.2rem;">
                        <span class="patch-show__accordion-title"><%= game.name %></span>
                        <span class="patch-show__accordion-preview"><%= pluralize(patches.count, "patch") %></span>
                      </div>
                    </summary>
                    <div class="patch-show__accordion-body">
                      <% patches.each do |patch| %>
                        <%= link_to patch_path(patch, return_to: my_profile_path), class: "patch-list-card" do %>
                          <div class="patch-list-card__icon">
                            <% if patch.game.cover_image.present? %>
                              <%= image_tag patch.game.cover_image, alt: patch.game.name, style: "width:36px;height:48px;object-fit:cover;border-radius:0.3rem;" %>
                            <% else %>
                              <i class="fa fa-file-text-o"></i>
                            <% end %>
                          </div>
                          <span class="patch-list-card__title">
                            <%= patch.title %>
                            <span class="patch-list-card__meta">
                              <small class="d-block text-muted mb-0"><%= patch.display_published_at.to_date.to_fs(:long) %></small>
                              <% if patch.freshly_published? %>
                                <span class="patch-fresh-badge">New</span>
                              <% end %>
                            </span>
                          </span>
                          <span class="patch-list-card__arrow"><i class="fa fa-chevron-right"></i></span>
                        <% end %>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            </div>

            <%= link_to my_profile_path, class: "d-block text-center mt-3", style: "font-size: 0.8rem; color: var(--gb-accent);" do %>
              View all patches <i class="fa fa-arrow-right"></i>
            <% end %>
          </div>
        <% else %>
          <div class="my-patches-page__empty">
            <div class="my-patches-page__empty-icon"><i class="fa fa-file-text"></i></div>
            <h2 class="my-patches-page__empty-title">No patches found for your favourited games</h2>
            <p class="my-patches-page__empty-copy">Favourite more games to build your patch feed.</p>
            <%= link_to games_path, class: "my-patches-page__action my-patches-page__action--primary" do %>
              <i class="fa fa-search"></i> Browse Games
            <% end %>
          </div>
        <% end %>
      </div>
    </div><%# /patches-panel %>

    <%# Events panel — shown when Event Reminders button is clicked %>
    <div id="events-panel" style="display: none;">
      <div class="my-events-page">
        <div class="my-events-page__header">
          <div class="my-events-page__heading">
            <h1 class="my-events-page__title">Event Reminders</h1>
            <p class="my-events-page__subtitle">Upcoming reminders for the events you want to keep track of.</p>
          </div>
        </div>

        <% if @reminders.any? %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 0 0.5rem;">
            <div class="my-events-page__sort-group">
              <button type="button" class="filter-btn active" id="profile-events-upcoming-btn" onclick="sortProfileEvents('upcoming')">Upcoming</button>
              <button type="button" class="filter-btn" id="profile-events-latest-btn" onclick="sortProfileEvents('latest')">Latest</button>
            </div>
            <button type="button" class="filter-btn" id="profile-events-organise-btn" onclick="toggleProfileEventView()">
              <i class="fa fa-filter"></i> Organise by game
            </button>
          </div>

          <div id="profile-events-flat">
            <div class="events-index__group-list">
              <% @reminders.each do |reminder| %>
                <% event = reminder.event %>
                <article class="game-card event-glow-card" data-start-date="<%= event.start_date&.iso8601 %>">
                  <%= link_to event_path(event), class: "game-card__link", aria: { label: "View #{event.title}" } do %>
                    <span class="visually-hidden">View <%= event.title %></span>
                  <% end %>
                  <div class="game-card__cover">
                    <% if event.game.cover_image.present? %>
                      <%= image_tag event.game.cover_image, alt: event.game.name, class: "game-card__img", loading: "lazy" %>
                    <% else %>
                      <div class="game-card__placeholder">
                        <i class="fa fa-gamepad"></i>
                      </div>
                    <% end %>
                    <div class="game-card__overlay"></div>
                    <% if @followed_games.map(&:id).include?(event.game_id) %>
                      <span class="event-card__badge">Following</span>
                    <% end %>
                    <div class="event-card__date-overlay">
                      <% if event.start_date.present? %>
                        <span class="event-card__date-num"><%= ordinal_day(event.start_date) %></span>
                        <span class="event-card__date-label"><%= event.start_date.strftime("%b %Y") %></span>
                      <% else %>
                        <span class="event-card__date-num">TBD</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="game-card__body">
                    <p class="event-card__game-label"><%= event.game.name %></p>
                    <h3 class="game-card__name"><%= event.title %></h3>
                    <span class="game-card__cta">View event</span>
                  </div>
                </article>
              <% end %>
            </div>
          </div>

          <div id="profile-events-by-game" style="display:none;">
            <div class="patch-show__accordions">
              <% @reminders.group_by { |r| r.event.game }.each do |game, reminders| %>
                <details class="patch-show__accordion">
                  <summary class="patch-show__accordion-summary">
                    <span class="patch-show__accordion-title"><%= game.name %></span>
                    <span class="patch-show__accordion-preview"><%= pluralize(reminders.count, "event") %></span>
                  </summary>
                  <div class="patch-show__accordion-body">
                    <div class="events-index__group-list">
                    <% reminders.each do |reminder| %>
                      <% event = reminder.event %>
                      <article class="game-card event-glow-card">
                        <%= link_to event_path(event), class: "game-card__link", aria: { label: "View #{event.title}" } do %>
                          <span class="visually-hidden">View <%= event.title %></span>
                        <% end %>
                        <div class="game-card__cover">
                          <% if event.game.cover_image.present? %>
                            <%= image_tag event.game.cover_image, alt: event.game.name, class: "game-card__img", loading: "lazy" %>
                          <% else %>
                            <div class="game-card__placeholder">
                              <i class="fa fa-gamepad"></i>
                            </div>
                          <% end %>
                          <div class="game-card__overlay"></div>
                          <% if @followed_games.map(&:id).include?(event.game_id) %>
                            <span class="event-card__badge">Following</span>
                          <% end %>
                          <div class="event-card__date-overlay">
                            <% if event.start_date.present? %>
                              <span class="event-card__date-num"><%= ordinal_day(event.start_date) %></span>
                              <span class="event-card__date-label"><%= event.start_date.strftime("%b %Y") %></span>
                            <% else %>
                              <span class="event-card__date-num">TBD</span>
                            <% end %>
                          </div>
                        </div>
                        <div class="game-card__body">
                          <p class="event-card__game-label"><%= event.game.name %></p>
                          <h3 class="game-card__name"><%= event.title %></h3>
                          <span class="game-card__cta">View event</span>
                        </div>
                      </article>
                    <% end %>
                    </div>
                  </div>
                </details>
              <% end %>
            </div>
          </div>

          <%= link_to my_profile_path, class: "d-block text-center mt-3", style: "font-size: 0.8rem; color: var(--gb-accent);" do %>
            View all events <i class="fa fa-arrow-right"></i>
          <% end %>
        <% else %>
          <div class="my-events-page__empty">
            <div class="my-events-page__empty-icon"><i class="fa fa-calendar"></i></div>
            <h2 class="my-events-page__empty-title">You do not have any saved event reminders yet</h2>
            <p class="my-events-page__empty-copy">Browse upcoming events and save reminders to build your personal event list.</p>
            <%= link_to events_path, class: "my-events-page__action my-events-page__action--primary" do %>
              <i class="fa fa-search"></i> Browse Events
            <% end %>
          </div>
        <% end %>
      </div>
    </div><%# /events-panel %>

  </main>
</div>

<script>
  function toggleProfileEventView() {
    var flat   = document.getElementById('profile-events-flat');
    var byGame = document.getElementById('profile-events-by-game');
    var btn    = document.getElementById('profile-events-organise-btn');
    var isGrouped = byGame.style.display !== 'none';
    flat.style.display   = isGrouped ? '' : 'none';
    byGame.style.display = isGrouped ? 'none' : '';
    btn.classList.toggle('active', !isGrouped);
  }

  function sortProfileEvents(order) {
    var flat   = document.getElementById('profile-events-flat');
    var byGame = document.getElementById('profile-events-by-game');
    var cards  = Array.from(flat.querySelectorAll('.game-card[data-start-date]'));
    var upcomingBtn = document.getElementById('profile-events-upcoming-btn');
    var latestBtn   = document.getElementById('profile-events-latest-btn');

    cards.sort(function(a, b) {
      var dA = new Date(a.dataset.startDate);
      var dB = new Date(b.dataset.startDate);
      return order === 'latest' ? dB - dA : dA - dB;
    });

    var grid = flat.querySelector('.events-index__group-list');
    cards.forEach(function(c) { grid.appendChild(c); });

    upcomingBtn.classList.toggle('active', order === 'upcoming');
    latestBtn.classList.toggle('active', order === 'latest');
  }

  function toggleProfilePatchView() {
    var flat   = document.getElementById('profile-patches-flat');
    var byGame = document.getElementById('profile-patches-by-game');
    var btn    = document.getElementById('profile-organise-btn');
    var isGrouped = byGame.style.display !== 'none';
    flat.style.display   = isGrouped ? '' : 'none';
    byGame.style.display = isGrouped ? 'none' : '';
    btn.classList.toggle('active', !isGrouped);
  }

  document.addEventListener('turbo:load', function () {
    // ── Panel references ───────────────────────────────────────────────────────
    var socialPanel    = document.getElementById('social-panel');
    var gamesPanel     = document.getElementById('games-panel');
    var patchesPanel   = document.getElementById('patches-panel');
    var eventsPanel    = document.getElementById('events-panel');
    var backToFeedBtn  = document.getElementById('back-to-feed-btn');

    // ── Games panel toggle ─────────────────────────────────────────────────────
    var gamesTabBtn  = document.querySelector('[data-games-tab-toggle]');
    var gamesActive  = false;

    function setActiveTab(btn) {
      [gamesTabBtn, patchesTabBtn, eventsTabBtn].forEach(function(b) {
        if (b) b.classList.remove('profile-subnav__tab--active');
      });
      if (btn) btn.classList.add('profile-subnav__tab--active');
    }

    function showGames() {
      gamesActive = true; patchesActive = false; eventsActive = false;
      socialPanel.style.display  = 'none';
      gamesPanel.style.display   = 'block';
      patchesPanel.style.display = 'none';
      eventsPanel.style.display  = 'none';
      setActiveTab(gamesTabBtn);
      if (backToFeedBtn) backToFeedBtn.style.display = 'inline-flex';
    }

    function showFeed() {
      gamesActive = false; patchesActive = false; eventsActive = false;
      socialPanel.style.display  = '';
      gamesPanel.style.display   = 'none';
      patchesPanel.style.display = 'none';
      eventsPanel.style.display  = 'none';
      setActiveTab(null);
      if (backToFeedBtn) backToFeedBtn.style.display = 'none';
    }

    if (gamesTabBtn && socialPanel && gamesPanel) {
      gamesTabBtn.addEventListener('click', function () {
        gamesActive ? showFeed() : showGames();
      });
    }

    // ── Patches panel toggle ───────────────────────────────────────────────────
    var patchesTabBtn = document.querySelector('[data-patches-tab-toggle]');
    var patchesActive = false;

    function showPatches() {
      patchesActive = true; gamesActive = false; eventsActive = false;
      socialPanel.style.display   = 'none';
      gamesPanel.style.display    = 'none';
      patchesPanel.style.display  = 'block';
      eventsPanel.style.display   = 'none';
      setActiveTab(patchesTabBtn);
      if (backToFeedBtn) backToFeedBtn.style.display = 'inline-flex';
    }

    if (patchesTabBtn && socialPanel && patchesPanel) {
      patchesTabBtn.addEventListener('click', function () {
        patchesActive ? showFeed() : showPatches();
      });
    }

    // ── Events panel toggle ────────────────────────────────────────────────────
    var eventsTabBtn = document.querySelector('[data-events-tab-toggle]');
    var eventsActive = false;

    function showEvents() {
      eventsActive = true; gamesActive = false; patchesActive = false;
      socialPanel.style.display   = 'none';
      gamesPanel.style.display    = 'none';
      patchesPanel.style.display  = 'none';
      eventsPanel.style.display   = 'block';
      setActiveTab(eventsTabBtn);
      if (backToFeedBtn) backToFeedBtn.style.display = 'inline-flex';
    }

    if (eventsTabBtn && socialPanel && eventsPanel) {
      eventsTabBtn.addEventListener('click', function () {
        eventsActive ? showFeed() : showEvents();
      });
    }

    if (backToFeedBtn) {
      backToFeedBtn.addEventListener('click', showFeed);
    }

    document.querySelectorAll('.like-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        btn.classList.add('heart-pop');
        btn.querySelector('i').addEventListener('animationend', function () {
          btn.classList.remove('heart-pop');
        }, { once: true });
      });
    });
  });
</script>

<!-- Friends Modal -->
<div class="modal" id="friendsModal" tabindex="-1" aria-labelledby="friendsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 400px;">
    <div class="modal-content" style="background: var(--gb-surface, #13162a); border: 1px solid rgba(124,92,252,0.25); border-radius: 18px; color: var(--gb-text, #e8eaf6);">
      <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.08); padding: 16px 20px;">
        <h5 class="modal-title" id="friendsModalLabel" style="font-size: 1.05rem; font-weight: 700; letter-spacing: 0.01em;">
          Friends
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="padding: 12px 16px;">
        <% if @pending_requests.any? %>
          <p style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted, #8891b4); margin: 0 4px 8px;">Requests (<%= @pending_requests.count %>)</p>
          <% @pending_requests.each do |req| %>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 4px; border-bottom: 1px solid rgba(255,255,255,0.05);"
                 id="modal-pending-<%= req.id %>"
                 data-user-path="<%= user_path(req.user) %>"
                 data-user-name="<%= req.user.display_name %>"
                 data-user-handle="<%= req.user.profile_handle %>"
                 data-user-initial="<%= req.user.display_name.first.upcase %>">
              <div class="modal-friend-row" data-profile-id="<%= req.user.id %>" style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; cursor: pointer;">
                <div style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent, #7c5cfc), #4f9cf9); display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; color: #fff; flex-shrink: 0; overflow: hidden;">
                  <% if req.user.avatar_image.attached? %>
                    <%= image_tag req.user.avatar_image, style: "width: 100%; height: 100%; object-fit: cover;" %>
                  <% elsif req.user.avatar_url.present? %>
                    <%= image_tag req.user.avatar_url, style: "width: 100%; height: 100%; object-fit: cover;" %>
                  <% else %>
                    <%= req.user.display_name.first.upcase %>
                  <% end %>
                </div>
                <div style="min-width: 0;">
                  <div style="font-size: 0.88rem; font-weight: 700; color: var(--gb-text, #e8eaf6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= req.user.display_name %></div>
                  <div style="font-size: 0.75rem; color: var(--gb-muted, #8891b4);">@<%= req.user.profile_handle %></div>
                </div>
              </div>
              <div style="display: flex; gap: 4px; flex-shrink: 0;">
                <button class="ff-modal-action-btn modal-pending-accept" data-friendship-id="<%= req.id %>" data-card="modal-pending-<%= req.id %>" style="border-color: #22c55e; background: rgba(34,197,94,0.2); color: #22c55e;" title="Accept"><i class="fa fa-check"></i></button>
                <button class="ff-modal-action-btn modal-pending-decline" data-friendship-id="<%= req.id %>" data-card="modal-pending-<%= req.id %>" style="border-color: rgba(255,80,80,0.4); color: rgba(255,80,80,0.7);" title="Decline"><i class="fa fa-times"></i></button>
              </div>
            </div>
          <% end %>
          <div style="margin: 12px 4px 8px; border-top: 1px solid rgba(255,255,255,0.06);"></div>
          <p style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gb-muted, #8891b4); margin: 8px 4px 8px;">Friends (<%= @friends.count %>)</p>
        <% end %>
        <div id="modal-friends-search" style="padding: 4px 0 8px;">
          <div style="position: relative;">
            <i class="fa fa-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--gb-muted, #8891b4); font-size: 0.8rem; pointer-events: none;"></i>
            <input id="friendsSearchInput" type="text" placeholder="Search friends…"
                   style="width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 7px 10px 7px 30px; color: var(--gb-text, #e8eaf6); font-size: 0.85rem; outline: none; box-sizing: border-box;"
                   autocomplete="off">
          </div>
        </div>

        <%# Card pane — shown when a friend row is clicked -%>
        <div id="modal-card-pane" style="display: none;">
          <button id="modal-card-back" type="button" style="display: inline-flex; align-items: center; gap: 6px; background: none; border: none; color: var(--gb-muted, #8891b4); font-size: 0.82rem; cursor: pointer; padding: 0 0 12px; font-family: inherit;">
            <i class="fa fa-arrow-left"></i> Back to friends
          </button>
          <div id="modal-card-content"></div>
        </div>

        <div id="modal-friends-list">
          <% if @friends.any? %>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
              <% @friends.each do |friend| %>
                <div class="modal-friend-row" data-profile-id="<%= friend.id %>"
                     style="display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px 8px; border-radius: 10px; background: rgba(255,255,255,0.04); cursor: pointer; text-align: center; min-width: 0; transition: background 0.15s;"
                     onmouseover="this.style.background='rgba(124,92,252,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.04)'">
                  <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--gb-accent, #7c5cfc), #4f9cf9); display: flex; align-items: center; justify-content: center; font-size: 1rem; font-weight: 700; color: #fff; flex-shrink: 0; overflow: hidden; margin: 0 auto;">
                    <% if friend.avatar_image.attached? %>
                      <%= image_tag friend.avatar_image, style: "width: 100%; height: 100%; object-fit: cover;" %>
                    <% elsif friend.avatar_url.present? %>
                      <%= image_tag friend.avatar_url, style: "width: 100%; height: 100%; object-fit: cover;" %>
                    <% else %>
                      <%= friend.display_name.first.upcase %>
                    <% end %>
                  </div>
                  <div style="min-width: 0; width: 100%;">
                    <div style="font-size: 0.82rem; font-weight: 700; color: var(--gb-text, #e8eaf6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= friend.display_name %></div>
                    <div style="font-size: 0.7rem; color: var(--gb-muted, #8891b4); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@<%= friend.profile_handle %></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p id="modal-no-friends" style="font-size: 0.85rem; color: var(--gb-muted, #8891b4); text-align: center; padding: 24px 0; margin: 0;">
              No friends yet. <%= link_to "Find some!", find_friends_path, style: "color: var(--gb-accent, #7c5cfc);" %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

