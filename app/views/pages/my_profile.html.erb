<script>
  // ── Friends modal — profile card pane ────────────────────────────────────────
  (function () {
    var friendsList = document.getElementById('modal-friends-list');
    var cardPane    = document.getElementById('modal-card-pane');
    var cardContent = document.getElementById('modal-card-content');
    var backBtn     = document.getElementById('modal-card-back');

    if (!friendsList || !cardPane || !cardContent || !backBtn) return;

    var searchWrap = document.getElementById('modal-friends-search');
    var searchInput = document.getElementById('friendsSearchInput');

    // Reset to list view whenever the modal opens
    document.getElementById('friendsModal').addEventListener('show.bs.modal', function () {
      cardPane.style.display    = 'none';
      friendsList.style.display = 'block';
      if (searchWrap) searchWrap.style.display = 'block';
      if (searchInput) { searchInput.value = ''; filterFriends(''); }
    });

    // Live search filter
    if (searchInput) {
      searchInput.addEventListener('input', function () { filterFriends(this.value); });
    }

    function filterFriends(query) {
      var q = query.trim().toLowerCase();
      var rows = friendsList.querySelectorAll('[data-profile-id]');
      var anyVisible = false;
      rows.forEach(function (row) {
        var parent = row.closest('div[style*="display: flex"]') || row.parentElement;
        var name   = (row.querySelector('[style*="font-weight: 700"]') || {}).textContent || '';
        var handle = (row.querySelector('[style*="color: var(--gb-muted"]') || {}).textContent || '';
        var match  = !q || name.toLowerCase().includes(q) || handle.toLowerCase().includes(q);
        parent.style.display = match ? (parent === row ? 'flex' : '') : 'none';
        if (match) anyVisible = true;
      });
      var noFriends = document.getElementById('modal-no-friends');
      if (noFriends) noFriends.style.display = (!anyVisible && q) ? 'block' : '';
    }

    // Delegate clicks on friend rows
    document.getElementById('friendsModal').addEventListener('click', function (e) {
      if (e.target.closest('#modal-card-back')) return; // handled below
      if (e.target.closest('.ff-modal-action-btn, .modal-pending-accept, .modal-pending-decline')) return;
      var row = e.target.closest('.modal-friend-row[data-profile-id]');
      if (!row) return;

      // Show loading state in card pane
      friendsList.style.display = 'none';
      if (searchWrap) searchWrap.style.display = 'none';
      cardPane.style.display    = 'block';
      cardContent.innerHTML =
        '<div style="padding: 2rem; text-align: center; color: var(--gb-muted, #8891b4);">' +
          '<i class="fa fa-circle-o-notch fa-spin fa-lg"></i>' +
        '</div>';

      fetch('/users/' + row.dataset.profileId + '/card', {
        headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        // Strip the close button — not needed inside the modal
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var closeBtn = tmp.querySelector('#ffCardClose');
        if (closeBtn) closeBtn.remove();
        cardContent.innerHTML = tmp.innerHTML;
        wireCardFriendBtns(cardContent);
      });
    });

    // Back button
    backBtn.addEventListener('click', function () {
      cardPane.style.display    = 'none';
      friendsList.style.display = 'block';
      if (searchWrap) searchWrap.style.display = 'block';
    });

    function wireCardFriendBtns(scope) {
      var csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      scope.querySelectorAll('.card-friend-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var action = btn.dataset.action;
          var userId = btn.dataset.userId;
          var fid    = btn.dataset.friendshipId;

          if (action === 'add') {
            fetch('/friendships', {
              method: 'POST',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify({ friend_id: userId })
            }).then(function (r) { return r.json(); }).then(function (data) {
              btn.dataset.action = 'cancel';
              btn.dataset.friendshipId = data.friendship_id;
              btn.classList.remove('social-profile-action--primary');
              btn.innerHTML = '<i class="fa fa-clock-o me-1"></i> Pending';
            });
          } else if (action === 'cancel' || action === 'unfriend') {
            fetch('/friendships/' + fid, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function () {
              btn.dataset.action = 'add';
              btn.dataset.friendshipId = '';
              btn.classList.add('social-profile-action--primary');
              btn.innerHTML = '<i class="fa fa-plus me-1"></i> Add Friend';
            });
          } else if (action === 'accept') {
            fetch('/friendships/' + fid, {
              method: 'PATCH',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function (r) { return r.json(); }).then(function (data) {
              var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
              wrap.outerHTML =
                '<button class="social-profile-action social-profile-action--full card-friend-btn"' +
                  ' data-action="unfriend" data-user-id="' + userId + '"' +
                  ' data-friendship-id="' + data.friendship_id + '">' +
                  '<i class="fa fa-check me-1"></i> Friends</button>';
              wireCardFriendBtns(scope);
            });
          } else if (action === 'decline') {
            fetch('/friendships/' + fid, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function () {
              var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
              wrap.outerHTML =
                '<button class="social-profile-action social-profile-action--primary social-profile-action--full card-friend-btn"' +
                  ' data-action="add" data-user-id="' + userId + '">' +
                  '<i class="fa fa-plus me-1"></i> Add Friend</button>';
              wireCardFriendBtns(scope);
            });
          }
        });
      });

      wireProfileCardTabs(scope);
    }

    function wireProfileCardTabs(container) {
      var nav = container.querySelector('.pub-profile-tab-nav');
      if (!nav) return;
      var tabs = nav.querySelectorAll('.pub-profile-tab[data-tab]');
      var panelContainer = container.querySelector('.pub-profile-tab-panels');
      if (!panelContainer) return;
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.dataset.tab;
          tabs.forEach(function (t) {
            var active = t.dataset.tab === target;
            t.style.borderBottomColor = active ? 'var(--gb-accent)' : 'transparent';
          });
          panelContainer.querySelectorAll('[data-panel]').forEach(function (p) {
            p.style.display = p.dataset.panel === target ? '' : 'none';
          });
        });
      });
    }
  })();

  // Wire up accept/decline buttons inside the Friends modal
  (function () {
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    document.querySelectorAll('.modal-pending-accept').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var friendshipId = btn.dataset.friendshipId;
        var cardId = btn.dataset.card;
        var card = document.getElementById(cardId);
        var userPath    = card ? card.dataset.userPath    : '#';
        var userName    = card ? card.dataset.userName    : '';
        var userHandle  = card ? card.dataset.userHandle  : '';
        var userInitial = card ? card.dataset.userInitial : '';

        fetch('/friendships/' + friendshipId, {
          method: 'PATCH',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          if (card) card.remove();
          updatePendingSection();
          addFriendCard(userPath, userName, userHandle, userInitial);
          updateFriendCount(1);
        });
      });
    });

    document.querySelectorAll('.modal-pending-decline').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var friendshipId = btn.dataset.friendshipId;
        var cardId = btn.dataset.card;
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          var card = document.getElementById(cardId);
          if (card) card.remove();
          updatePendingSection();
        });
      });
    });

    function updatePendingSection() {
      var modal = document.getElementById('friendsModal');
      if (!modal) return;
      var remaining = modal.querySelectorAll('[id^="modal-pending-"]').length;
      if (remaining === 0) {
        modal.querySelectorAll('.modal-body > p').forEach(function (p) {
          if (p.textContent.includes('Requests') || p.textContent.includes('Friends (')) p.remove();
        });
        modal.querySelectorAll('.modal-body > div[style*="border-top"]').forEach(function (d) { d.remove(); });
      } else {
        modal.querySelectorAll('.modal-body > p').forEach(function (p) {
          if (p.textContent.includes('Requests')) {
            p.textContent = 'Requests (' + remaining + ')';
          }
        });
      }
      // Update the pending badge on the stat button
      var badge = document.querySelector('.pending-badge');
      if (badge) {
        if (remaining === 0) {
          badge.remove();
        } else {
          badge.textContent = remaining;
        }
      }
    }

    function addFriendCard(userPath, userName, userHandle, userInitial) {
      var list = document.getElementById('modal-friends-list');
      if (!list) return;
      // Remove "no friends" placeholder if present
      var placeholder = document.getElementById('modal-no-friends');
      if (placeholder) placeholder.remove();
      // Find or create the grid wrapper
      var grid = list.querySelector('[style*="grid-template-columns"]');
      if (!grid) {
        grid = document.createElement('div');
        grid.style.cssText = 'display:grid;grid-template-columns:1fr 1fr;gap:6px;';
        list.appendChild(grid);
      }
      var card = document.createElement('div');
      card.className = 'modal-friend-row';
      card.dataset.profileId = userPath.split('/').pop();
      card.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:6px;padding:10px 8px;border-radius:10px;background:rgba(255,255,255,0.04);cursor:pointer;text-align:center;min-width:0;';
      card.onmouseover = function() { this.style.background = 'rgba(124,92,252,0.12)'; };
      card.onmouseout  = function() { this.style.background = 'rgba(255,255,255,0.04)'; };
      card.innerHTML =
        '<div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--gb-accent,#7c5cfc),#4f9cf9);display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;color:#fff;flex-shrink:0;margin:0 auto;">' + userInitial + '</div>' +
        '<div style="min-width:0;width:100%;">' +
          '<div style="font-size:0.82rem;font-weight:700;color:var(--gb-text,#e8eaf6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + userName + '</div>' +
          '<div style="font-size:0.7rem;color:var(--gb-muted,#8891b4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@' + userHandle + '</div>' +
        '</div>';
      grid.appendChild(card);
    }

    function updateFriendCount(delta) {
      // Update the stat button on the profile
      var statBtn = document.querySelector('[data-bs-target="#friendsModal"] .social-stat__count');
      if (statBtn) {
        var n = parseInt(statBtn.textContent.match(/\d+/) || [0], 10) + delta;
        statBtn.textContent = n + (n === 1 ? ' Friend' : ' Friends');
      }
    }
  })();

  (function () {
    var modal       = document.getElementById('findFriendsModal');
    var input       = document.getElementById('ffModalInput');
    var results     = document.getElementById('ffModalResults');
    var searchPane  = document.getElementById('ffModalSearchPane');
    var cardPane    = document.getElementById('ffModalCardPane');
    var cardContent = document.getElementById('ffModalCardContent');
    var cardBack    = document.getElementById('ffModalCardBack');
    var timer   = null;
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    if (!modal || !input || !results) return;

    modal.addEventListener('hidden.bs.modal', function () {
      input.value = '';
      results.innerHTML = '';
      showSearchPane();
    });

    modal.addEventListener('shown.bs.modal', function () {
      input.focus();
    });

    if (cardBack) {
      cardBack.addEventListener('click', showSearchPane);
    }

    function showSearchPane() {
      if (cardPane)   cardPane.style.display   = 'none';
      if (searchPane) searchPane.style.display = '';
    }

    function showCardPane(userId) {
      if (searchPane) searchPane.style.display = 'none';
      if (cardPane)   cardPane.style.display   = '';
      cardContent.innerHTML =
        '<div style="padding:2rem;text-align:center;color:var(--gb-muted,#8891b4);">' +
          '<i class="fa fa-circle-o-notch fa-spin fa-lg"></i>' +
        '</div>';

      fetch('/users/' + userId + '/card', {
        headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var closeBtn = tmp.querySelector('#ffCardClose');
        if (closeBtn) closeBtn.remove();
        cardContent.innerHTML = tmp.innerHTML;
        wireCardFriendBtns(cardContent);
        // Friends-in-card → load their card
        cardContent.querySelectorAll('[data-card-user-id]').forEach(function (el) {
          el.addEventListener('click', function () { showCardPane(el.dataset.cardUserId); });
        });
      });
    }

    input.addEventListener('input', function () {
      clearTimeout(timer);
      var q = input.value.trim();
      if (!q) { results.innerHTML = ''; return; }

      timer = setTimeout(function () {
        fetch('<%= find_friends_path %>.json?q=' + encodeURIComponent(q), {
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (users) { renderResults(users); });
      }, 250);
    });

    function renderResults(users) {
      if (!users.length) {
        results.innerHTML = '<p style="font-size:0.82rem;color:var(--gb-muted,#8891b4);text-align:center;padding:16px 0;margin:0;">No users found.</p>';
        return;
      }
      var html = '<div style="display:flex;flex-direction:column;gap:4px;">';
      users.forEach(function (u) {
        var btnHtml = '';
        if (u.pending_sent) {
          btnHtml = '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.friendship_id + '" data-action="cancel" style="border-color:rgba(255,255,255,0.2);color:var(--gb-muted,#8891b4);" title="Cancel request"><i class="fa fa-paper-plane"></i></button>';
        } else if (u.pending_received) {
          btnHtml =
            '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.incoming_request_id + '" data-action="accept" style="border-color:var(--gb-accent,#7c5cfc);background:rgba(124,92,252,0.2);color:var(--gb-accent,#7c5cfc);" title="Accept"><i class="fa fa-check"></i></button>' +
            '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.incoming_request_id + '" data-action="decline" style="border-color:rgba(255,80,80,0.4);color:rgba(255,80,80,0.7);" title="Decline"><i class="fa fa-times"></i></button>';
        } else if (u.is_friend) {
          btnHtml = '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-friendship-id="' + u.friendship_id + '" data-action="unfriend" style="border-color:var(--gb-accent,#7c5cfc);background:rgba(124,92,252,0.2);color:var(--gb-accent,#7c5cfc);" title="Remove friend"><i class="fa fa-check"></i></button>';
        } else {
          btnHtml = '<button class="ff-modal-action-btn" data-user-id="' + u.id + '" data-action="add" style="border-color:rgba(255,255,255,0.2);color:var(--gb-muted,#8891b4);" title="Send friend request"><i class="fa fa-plus"></i></button>';
        }
        html +=
          '<div style="display:flex;align-items:center;gap:10px;padding:8px 4px;border-bottom:1px solid rgba(255,255,255,0.05);" id="modal-card-' + u.id + '">' +
            '<div data-ff-profile-id="' + u.id + '" style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;cursor:pointer;">' +
              '<div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--gb-accent,#7c5cfc),#4f9cf9);display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:#fff;flex-shrink:0;">' + escHtml(u.initial) + '</div>' +
              '<div style="flex:1;min-width:0;">' +
                '<div style="font-size:0.85rem;font-weight:700;color:var(--gb-text,#e8eaf6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + escHtml(u.display) + '</div>' +
                (u.email ? '<div style="font-size:0.73rem;color:var(--gb-muted,#8891b4);">' + escHtml(u.email) + '</div>' : '') +
              '</div>' +
            '</div>' +
            '<div style="display:flex;gap:4px;flex-shrink:0;">' + btnHtml + '</div>' +
          '</div>';
      });
      html += '</div>';
      results.innerHTML = html;

      results.querySelectorAll('.ff-modal-action-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { handleAction(this); });
      });

      results.querySelectorAll('[data-ff-profile-id]').forEach(function (el) {
        el.addEventListener('click', function () { showCardPane(el.dataset.ffProfileId); });
      });
    }

    function handleAction(btn) {
      var action       = btn.dataset.action;
      var userId       = btn.dataset.userId;
      var friendshipId = btn.dataset.friendshipId;

      if (action === 'add') {
        fetch('/friendships', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ friend_id: userId })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          btn.dataset.action = 'cancel';
          btn.dataset.friendshipId = data.friendship_id;
          btn.title = 'Cancel request';
          btn.innerHTML = '<i class="fa fa-paper-plane"></i>';
          btn.style.borderColor = 'rgba(255,255,255,0.2)';
          btn.style.color = 'var(--gb-muted,#8891b4)';
          btn.style.background = 'transparent';
        });

      } else if (action === 'cancel') {
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          btn.dataset.action = 'add';
          btn.dataset.friendshipId = '';
          btn.title = 'Send friend request';
          btn.innerHTML = '<i class="fa fa-plus"></i>';
        });

      } else if (action === 'accept') {
        fetch('/friendships/' + friendshipId, {
          method: 'PATCH',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var wrap = btn.closest('div[style*="flex-shrink"]');
          if (wrap) {
            wrap.innerHTML = '<button class="ff-modal-action-btn" data-action="unfriend" data-user-id="' + userId + '" data-friendship-id="' + data.friendship_id + '" style="border-color:var(--gb-accent,#7c5cfc);background:rgba(124,92,252,0.2);color:var(--gb-accent,#7c5cfc);" title="Remove friend"><i class="fa fa-check"></i></button>';
            wrap.querySelector('.ff-modal-action-btn').addEventListener('click', function () { handleAction(this); });
          }
        });

      } else if (action === 'decline') {
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          var wrap = btn.closest('div[style*="flex-shrink"]');
          if (wrap) {
            wrap.innerHTML = '<button class="ff-modal-action-btn" data-action="add" data-user-id="' + userId + '" style="border-color:rgba(255,255,255,0.2);color:var(--gb-muted,#8891b4);" title="Send friend request"><i class="fa fa-plus"></i></button>';
            wrap.querySelector('.ff-modal-action-btn').addEventListener('click', function () { handleAction(this); });
          }
        });

      } else if (action === 'unfriend') {
        fetch('/friendships/' + friendshipId, {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
        }).then(function () {
          btn.dataset.action = 'add';
          btn.dataset.friendshipId = '';
          btn.title = 'Send friend request';
          btn.innerHTML = '<i class="fa fa-plus"></i>';
          btn.style.borderColor = 'rgba(255,255,255,0.2)';
          btn.style.color = 'var(--gb-muted,#8891b4)';
          btn.style.background = 'transparent';
        });
      }
    }

    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  })();

  // ── Feed avatar → profile preview modal ─────────────────────────────────────
  (function () {
    var previewModal = document.getElementById('profilePreviewModal');
    var previewBody  = document.getElementById('profilePreviewBody');
    if (!previewModal || !previewBody) return;

    var modalTrigger = document.getElementById('profilePreviewTrigger');
    var activeId = null;

    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('.feed-profile-trigger[data-profile-id]');
      if (!trigger) return;
      var userId = trigger.dataset.profileId;
      if (!userId) return;

      if (userId !== activeId) {
        activeId = userId;
        previewBody.innerHTML =
          '<div style="padding: 3rem; text-align: center; color: var(--gb-muted, #8891b4);">' +
            '<i class="fa fa-circle-o-notch fa-spin fa-lg"></i>' +
          '</div>';
        fetch('/users/' + userId + '/card', {
          headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var closeBtn = tmp.querySelector('#ffCardClose');
          if (closeBtn) {
            closeBtn.setAttribute('data-bs-dismiss', 'modal');
            closeBtn.removeAttribute('id');
          }
          previewBody.innerHTML = tmp.innerHTML;
          wirePreviewCard(previewBody);
        });
      }

      modalTrigger.click();
    });

    previewModal.addEventListener('hidden.bs.modal', function () {
      activeId = null;
    });

    function wirePreviewCard(scope) {
      var csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      scope.querySelectorAll('.card-friend-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var action = btn.dataset.action;
          var userId = btn.dataset.userId;
          var fid    = btn.dataset.friendshipId;

          if (action === 'add') {
            fetch('/friendships', {
              method: 'POST',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify({ friend_id: userId })
            }).then(function (r) { return r.json(); }).then(function (data) {
              btn.dataset.action = 'cancel';
              btn.dataset.friendshipId = data.friendship_id;
              btn.classList.remove('social-profile-action--primary');
              btn.innerHTML = '<i class="fa fa-clock-o me-1"></i> Pending';
            });
          } else if (action === 'cancel' || action === 'unfriend') {
            fetch('/friendships/' + fid, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function () {
              btn.dataset.action = 'add';
              btn.dataset.friendshipId = '';
              btn.classList.add('social-profile-action--primary');
              btn.innerHTML = '<i class="fa fa-plus me-1"></i> Add Friend';
            });
          } else if (action === 'accept') {
            fetch('/friendships/' + fid, {
              method: 'PATCH',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function (r) { return r.json(); }).then(function (data) {
              var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
              wrap.outerHTML =
                '<button class="social-profile-action social-profile-action--full card-friend-btn"' +
                  ' data-action="unfriend" data-user-id="' + userId + '"' +
                  ' data-friendship-id="' + data.friendship_id + '">' +
                  '<i class="fa fa-check me-1"></i> Friends</button>';
              wirePreviewCard(scope);
            });
          } else if (action === 'decline') {
            fetch('/friendships/' + fid, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
            }).then(function () {
              var wrap = btn.closest('.card-friend-wrap') || btn.parentElement;
              wrap.outerHTML =
                '<button class="social-profile-action social-profile-action--primary social-profile-action--full card-friend-btn"' +
                  ' data-action="add" data-user-id="' + userId + '">' +
                  '<i class="fa fa-plus me-1"></i> Add Friend</button>';
              wirePreviewCard(scope);
            });
          }
        });
      });

      var nav = scope.querySelector('.pub-profile-tab-nav');
      if (!nav) return;
      var tabs = nav.querySelectorAll('.pub-profile-tab[data-tab]');
      var panelContainer = scope.querySelector('.pub-profile-tab-panels');
      if (!panelContainer) return;
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.dataset.tab;
          tabs.forEach(function (t) {
            t.style.borderBottomColor = t.dataset.tab === target ? 'var(--gb-accent)' : 'transparent';
          });
          panelContainer.querySelectorAll('[data-panel]').forEach(function (p) {
            p.style.display = p.dataset.panel === target ? '' : 'none';
          });
        });
      });
    }
  })();
</script>

<style>
