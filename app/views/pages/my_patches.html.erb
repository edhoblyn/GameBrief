<% content_for :title, "My Patch Updates" %>

<div class="my-patches-page container">
  <div class="my-patches-page__header">
    <div>
      <p class="my-patches-page__eyebrow">Profile</p>
      <h1 class="my-patches-page__title">My Patch Updates</h1>
      <p class="my-patches-page__subtitle">Recent patch notes from your favourited games.</p>
    </div>
    <div class="my-patches-page__actions">
      <%= link_to my_profile_path, class: "my-patches-page__action" do %>
        <i class="fa fa-arrow-left"></i>
        Back to Profile
      <% end %>
    </div>
  </div>

  <div class="my-patches-page__filters">
    <%= form_with url: my_patches_path, method: :get, local: true, class: "my-patches-page__filter-form" do %>
      <div class="my-patches-page__filter-group">
        <%= label_tag :date_filter, "Date range", class: "my-patches-page__filter-label" %>
        <%= select_tag :date_filter,
              options_for_select(Patch::DATE_FILTERS.map { |value, label| [label, value] }, @date_filter),
              class: "my-patches-page__filter-select",
              onchange: "this.form.requestSubmit()" %>
      </div>

      <div class="my-patches-page__sort-group">
        <% if @patches.any? %>
          <button type="button" class="filter-btn" id="organise-btn" onclick="togglePatchView()">
            <i class="fa fa-filter"></i> Organise by game
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @patches.any? %>
    <div class="profile-rail-card" style="padding: 1.25rem;">
    <div id="patches-flat">
      <% @patches.each do |patch| %>
        <%= link_to patch_path(patch, return_to: request.fullpath), class: "patch-list-card" do %>
          <div class="patch-list-card__icon">
                <% if patch.game.cover_image.present? %>
                  <%= image_tag patch.game.cover_image, alt: patch.game.name, style: "width:36px;height:48px;object-fit:cover;border-radius:0.3rem;" %>
                <% else %>
                  <i class="fa fa-file-text-o"></i>
                <% end %>
              </div>
          <span class="patch-list-card__title">
            <small class="d-block text-muted mb-0" style="font-size:0.78rem; font-weight:600;"><%= patch.game.name %></small>
            <%= patch.title %>
            <span class="patch-list-card__meta">
              <small class="d-block text-muted mb-0"><%= patch.display_published_at.to_date.to_fs(:long) %></small>
              <% if patch.freshly_published? %>
                <span class="patch-fresh-badge">New</span>
              <% end %>
            </span>
          </span>
          <span class="patch-list-card__arrow"><i class="fa fa-chevron-right"></i></span>
        <% end %>
      <% end %>
    </div>

    <div id="patches-by-game" style="display:none;">
      <div class="patch-show__accordions">
        <% @patches.group_by(&:game).each do |game, patches| %>
          <details class="patch-show__accordion">
            <summary class="patch-show__accordion-summary" style="flex-direction:row;align-items:center;gap:0.75rem;">
              <% if game.cover_image.present? %>
                <%= image_tag game.cover_image, alt: game.name, style: "width:36px;height:48px;object-fit:cover;border-radius:0.3rem;flex-shrink:0;" %>
              <% end %>
              <div style="display:flex;flex-direction:column;gap:0.2rem;">
                <span class="patch-show__accordion-title"><%= game.name %></span>
                <span class="patch-show__accordion-preview"><%= pluralize(patches.count, "patch") %></span>
              </div>
            </summary>
            <div class="patch-show__accordion-body">
              <% patches.each do |patch| %>
                <%= link_to patch_path(patch, return_to: request.fullpath), class: "patch-list-card" do %>
                  <div class="patch-list-card__icon">
                <% if patch.game.cover_image.present? %>
                  <%= image_tag patch.game.cover_image, alt: patch.game.name, style: "width:36px;height:48px;object-fit:cover;border-radius:0.3rem;" %>
                <% else %>
                  <i class="fa fa-file-text-o"></i>
                <% end %>
              </div>
                  <span class="patch-list-card__title">
                    <%= patch.title %>
                    <span class="patch-list-card__meta">
                      <small class="d-block text-muted mb-0"><%= patch.display_published_at.to_date.to_fs(:long) %></small>
                      <% if patch.freshly_published? %>
                        <span class="patch-fresh-badge">New</span>
                      <% end %>
                    </span>
                  </span>
                  <span class="patch-list-card__arrow"><i class="fa fa-chevron-right"></i></span>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </div>

    <script>
      function togglePatchView() {
        var flat = document.getElementById("patches-flat");
        var byGame = document.getElementById("patches-by-game");
        var btn = document.getElementById("organise-btn");
        var isGrouped = byGame.style.display !== "none";
        flat.style.display = isGrouped ? "" : "none";
        byGame.style.display = isGrouped ? "none" : "";
        btn.classList.toggle("active", !isGrouped);
      }
    </script>
    </div>
  <% else %>
    <div class="my-patches-page__empty">
      <div class="my-patches-page__empty-icon">
        <i class="fa fa-file-text"></i>
      </div>
      <h2 class="my-patches-page__empty-title">No patches found for your favourited games</h2>
      <p class="my-patches-page__empty-copy">Try a wider date range or favourite more games to build your patch feed.</p>
      <div class="my-patches-page__actions">
        <%= link_to my_games_path, class: "my-patches-page__action" do %>
          <i class="fa fa-gamepad"></i>
          View My Games
        <% end %>
        <%= link_to games_path, class: "my-patches-page__action my-patches-page__action--primary" do %>
          <i class="fa fa-search"></i>
          Browse All Games
        <% end %>
      </div>
    </div>
  <% end %>
</div>
