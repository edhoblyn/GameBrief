<div class="patch-show">
  <div class="patch-show__header container">
    <div class="patch-show__header-inner">
      <% if @patch.game.cover_image.present? %>
        <%= image_tag @patch.game.cover_image, alt: @patch.game.name, class: "patch-show__game-cover" %>
      <% end %>
      <div>
        <div class="patch-show__header__breadcrumb">
          <%= link_to @patch.game.name, game_path(@patch.game) %> &rsaquo; Patches
        </div>
        <h1><%= @patch.title %></h1>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="container mt-3 mb-3">
      <%= link_to "← Back to patches", @back_to_patches_path, style: "font-size:0.82rem; color: rgba(255,255,255,0.45); text-decoration:none;" %>
    </div>

    <div class="row g-4">
      <div class="col-lg-7">
        <%= render "notes", patch: @patch %>
      </div>

      <% if user_signed_in? && @chat %>
        <div class="col-lg-5">
          <div class="patch-show__sidebar">
            <div class="chatbot"
                 data-controller="chat-stream"
                 data-chat-stream-stream-url-value="<%= stream_patch_chat_path(@patch, @chat) %>"
                 data-chat-stream-max-messages-value="<%= Message::MAX_USER_MESSAGES %>"
                 data-chat-stream-user-message-count-value="<%= @chat.user_message_count %>">
              <div class="chatbot__header">
                <div class="chatbot__mascot-avatar">
                  <svg width="40" height="40" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle class="briffy-bg briffy-border" cx="21" cy="21" r="20" stroke-width="1.5"/>
                    <polygon class="briffy-ear" points="12,11 7,2 17,8"/>
                    <polygon class="briffy-ear" points="30,11 35,2 25,8"/>
                    <circle cx="15" cy="20" r="6.5" fill="white"/>
                    <circle cx="27" cy="20" r="6.5" fill="white"/>
                    <circle class="briffy-iris" cx="15" cy="20" r="4.5"/>
                    <circle class="briffy-iris" cx="27" cy="20" r="4.5"/>
                    <circle cx="15.8" cy="19.2" r="2.2" fill="#0d0d14"/>
                    <circle cx="27.8" cy="19.2" r="2.2" fill="#0d0d14"/>
                    <circle cx="16.8" cy="18.2" r="1" fill="white" opacity="0.9"/>
                    <circle cx="28.8" cy="18.2" r="1" fill="white" opacity="0.9"/>
                    <polygon points="21,25 19,28.5 23,28.5" fill="#fbbf24"/>
                    <path class="briffy-smile" d="M14,33 Q21,38 28,33" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                  </svg>
                </div>
                <div class="chatbot__header-text">
                  <span class="chatbot__mascot-name">Chat with Briffy</span>
                  <span class="chatbot__header-sub">Ask about this patch</span>
                </div>
              </div>

              <div id="messages" class="chatbot__messages" data-chat-stream-target="messages">
                <%= render partial: "messages/message", collection: @chat.messages, as: :message %>
                <% if @chat.messages.empty? %>
                  <p class="chatbot__empty">I've gone through every single line of this patch. Fire away, I'm ready!</p>
                <% end %>
              </div>

              <script>
                (function() {
                  function scrollToBottom() {
                    var el = document.getElementById("messages");
                    if (el) el.scrollTop = el.scrollHeight;
                  }
                  scrollToBottom();
                  document.addEventListener("turbo:after-stream-render", scrollToBottom);
                })();
              </script>

              <div id="new_message_container">
                <%= render "messages/form", patch: @patch, chat: @chat, message: Message.new %>
              </div>

            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
